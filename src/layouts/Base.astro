---
import '@fontsource-variable/archivo';
import '@fontsource-variable/inter';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Soundtrack from '../components/Soundtrack.astro';
import MatrixWorld from '../components/MatrixWorld.astro';
import archivoWoff2 from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import instrumentSerifWoff2 from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'iZad Casanova — Official Site | Music & Zaddy Collection',
  description = "Official website of iZad Casanova — Bronx-born artist. Stream the latest singles and shop the Zaddy Collection.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!DOCTYPE html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070a0e" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' data: https://*.paypal.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.paypalobjects.com; font-src 'self'; media-src 'self'; connect-src 'self' blob: https://*.paypal.com https://*.paypalobjects.com; frame-src https://*.paypal.com https://www.youtube-nocookie.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; upgrade-insecure-requests" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-64.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={archivoWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={instrumentSerifWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/hero-poster.webp" as="image" type="image/webp" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://zaddy.art/og-image.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://zaddy.art/og-image.jpg" />
    <ClientRouter />

    <script>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <MatrixWorld />
    <div class="grain" aria-hidden="true"></div>
    <slot />
    <Soundtrack />
    <script>
      import '../scripts/motion.js';
    </script>
  </body>
</html>
