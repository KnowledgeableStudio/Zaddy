---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import ImageViewer from '../components/ImageViewer.astro';
import Hologram from '../components/Hologram.astro';
import { Image } from 'astro:assets';

import ch01Img from '../assets/story/ch01-origins.jpg';
import ch02Img from '../assets/story/ch02-struggle.jpg';
import ch03Img from '../assets/story/ch03-therapy.jpg';
import ch04Img from '../assets/story/ch04-mission.jpg';
import ch05Img from '../assets/story/ch05-faith.jpg';
import ch06Img from '../assets/story/ch06-beyond.jpg';
import ch07Img from '../assets/story/ch07-family.jpg';
import finaleImg from '../assets/story/finale-skyline.jpg';

const CHAPTERS = [
  {
    num: '01',
    title: 'Origins',
    slate: 'CH.01 — ORIGINS · BRONX, NY · 1989',
    img: ch01Img,
    alt: 'Elevated train tracks running past a bridge toward distant city buildings',
    narration:
      'New York City, 1989. A first-generation American is born in the Bronx — where he still lives, still chasing a dream.',
    quote:
      "I graduated from Monroe College with a degree in Computer Analysis, but life hasn't made things easy. I've kept pushing forward.",
  },
  {
    num: '02',
    title: 'The Struggle',
    slate: 'CH.02 — THE STRUGGLE · DOMINICAN REPUBLIC · 1996–2006',
    img: ch02Img,
    alt: 'Motorbikes riding down a busy street',
    narration:
      'From 1996 to 2006, he lives in the Dominican Republic — after his parents and family are indicted for drug trafficking. Their choices cast a long shadow.',
    quote:
      "I was offered many opportunities tied to criminal activity. I never let my soul fall. I chose to do what's right.",
  },
  {
    num: '03',
    title: 'Music as Therapy',
    slate: 'CH.03 — MUSIC AS THERAPY',
    img: ch03Img,
    alt: 'Condenser microphone on a stand against a black background',
    narration:
      'Back home, the weight doesn’t lift. His own siblings turn their backs on their mother — and on a sister battling leukemia. He pays the rent, the medicine, the food. Alone.',
    quote: "Music is my therapy. It's the voice I use when words fail me.",
  },
  {
    num: '04',
    title: 'The Mission',
    slate: 'CH.04 — THE MISSION',
    img: ch04Img,
    alt: 'City buildings viewed from above at night',
    narration: 'What he’s chasing was never money.',
    quote:
      "I'm chasing fame to go to war with the system — to challenge injustice, to speak for the unheard. My mission is bigger than me.",
  },
  {
    num: '05',
    title: 'Faith',
    slate: 'CH.05 — FAITH',
    img: ch05Img,
    alt: 'Sunlight streaming through windows into a dark room',
    narration: 'The engine underneath it all isn’t ambition.',
    quote:
      'I believe in Allah, in Judgment Day, in karma. Faith, resilience, love — helping others is what brings me peace.',
  },
  {
    num: '06',
    title: 'Beyond the Music',
    slate: 'CH.06 — BEYOND THE MUSIC',
    img: ch06Img,
    alt: 'Rows of green plants inside a greenhouse',
    narration:
      'There’s more on the shelf than songs. Code — SQL, CSS, HTML. Content. And a self-built method for growing food sustainably, designed for under-resourced communities.',
    quote:
      "It's stuck there — not for lack of vision, but lack of funding. It could change lives. It's still waiting.",
  },
  {
    num: '07',
    title: 'Family',
    slate: 'CH.07 — FAMILY',
    img: ch07Img,
    alt: 'Silhouette of a parent carrying a child against warm light',
    narration: 'Above everything: a daughter and a son.',
    quote: "They're my reason to keep dreaming, to keep fighting, to never give up.",
  },
];
---

<Base
  title="The Story — iZad Casanova | Zaddy Collection"
  description="The story behind iZad Casanova — Bronx-born artist. Struggle, faith, family, and the mission behind the music and the Zaddy Collection."
>
  <Nav />

  <main id="main">
    <section id="story" class="story-hero" aria-labelledby="story-title">
      <div class="container story-hero-inner">
        <span class="section-index reveal">The Story</span>
        <h1 id="story-title" class="display story-hero-title reveal" data-delay="1">
          From the<br />Bronx to<br />the World
        </h1>
        <p class="story-hero-sub serif-accent reveal" data-delay="2">
          The story behind the music.
        </p>
        <Hologram />
        <p class="story-hero-hint reveal" data-delay="3" aria-hidden="true">Scroll to read</p>
      </div>
    </section>

    <section class="cold-open" aria-label="Atmospheric transit footage">
      <div class="cold-frame" data-parallax>
        <video
          id="cold-video"
          class="visual-media"
          src="/story/cold-open.mp4"
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        ></video>
        <span class="visual-grade" aria-hidden="true"></span>
        <span class="visual-slate" aria-hidden="true">Prologue — In Transit</span>
        <button
          type="button"
          id="cold-toggle"
          class="cold-toggle"
          aria-label="Pause ambient video"
          aria-pressed="false"
        >
          <svg class="ct-pause" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M7 4h4v16H7zM13 4h4v16h-4z" />
          </svg>
          <svg class="ct-play" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
        </button>
      </div>
    </section>

    <div class="chapters container">
      {
        CHAPTERS.map((ch) => (
          <section class="chapter reveal" aria-labelledby={`ch-${ch.num}`}>
            <span class="chapter-num display" aria-hidden="true">{ch.num}</span>
            <div class="chapter-body">
              <h2 id={`ch-${ch.num}`} class="chapter-title display">{ch.title}</h2>
              <p class="narration">{ch.narration}</p>
              <blockquote class="chapter-quote serif-accent">{ch.quote}</blockquote>
            </div>
            <figure class="chapter-visual" data-parallax>
              <Image
                src={ch.img}
                alt={ch.alt}
                widths={[480, 800, 1400]}
                sizes="(min-width: 860px) 42vw, 94vw"
                loading="lazy"
                decoding="async"
                class="visual-media"
              />
              <span class="visual-grade" aria-hidden="true"></span>
              <figcaption class="visual-slate">{ch.slate}</figcaption>
            </figure>
          </section>
        ))
      }
    </div>

    <section class="story-finale" aria-label="Closing">
      <Image
        src={finaleImg}
        alt=""
        widths={[800, 1600]}
        sizes="100vw"
        loading="lazy"
        decoding="async"
        class="finale-bg"
        aria-hidden="true"
      />
      <div class="container story-finale-inner reveal">
        <blockquote class="finale-quote serif-accent">
          “Through my music, I don't just want to be heard — I want to be felt. No matter how
          broken life gets, there's still hope.”
        </blockquote>
        <div class="finale-ctas">
          <a href="/#music" class="btn btn-primary">Listen to the Music</a>
          <a href="/" class="btn btn-hud">Back to Home</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <CartDrawer />
  <ImageViewer />

  <script>
    import '../scripts/main.js';
  </script>

  <script>
    /* Story-page only: ambient video lifecycle + scroll parallax.
       Kept out of main.js so the homepage pays zero cost. */
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ambient video — plays only while in view, pauses offscreen,
    // full stop for reduced-motion users (poster frame instead)
    const coldVideo = document.getElementById('cold-video');
    const coldToggle = document.getElementById('cold-toggle');
    if (coldVideo && coldToggle) {
      const frame = coldVideo.closest('.cold-frame');
      coldVideo.addEventListener('error', () => frame.classList.add('no-video'));

      let userPaused = reducedMotion;
      const syncToggle = () => {
        coldToggle.setAttribute('aria-pressed', String(userPaused));
        coldToggle.setAttribute(
          'aria-label',
          userPaused ? 'Play ambient video' : 'Pause ambient video'
        );
        frame.classList.toggle('is-paused', userPaused);
      };
      coldToggle.addEventListener('click', () => {
        userPaused = !userPaused;
        if (userPaused) coldVideo.pause();
        else coldVideo.play().catch(() => {});
        syncToggle();
      });

      if (reducedMotion) {
        coldVideo.pause();
        syncToggle();
      } else {
        new IntersectionObserver(
          (entries) => {
            if (userPaused) return;
            if (entries[0].isIntersecting) coldVideo.play().catch(() => {});
            else coldVideo.pause();
          },
          { rootMargin: '120px' }
        ).observe(coldVideo);
      }
    }

    // light parallax — whole frame drifts a few px against scroll.
    // transform-only, rAF-throttled, disabled under reduced motion.
    if (!reducedMotion) {
      const driftEls = [...document.querySelectorAll('[data-parallax]')];
      let ticking = false;
      const drift = () => {
        ticking = false;
        const vh = window.innerHeight;
        for (const el of driftEls) {
          const r = el.getBoundingClientRect();
          if (r.bottom < -80 || r.top > vh + 80) continue;
          const progress = (r.top + r.height / 2 - vh / 2) / vh; // -0.5 … 0.5
          el.style.transform = `translateY(${(progress * -26).toFixed(1)}px)`;
        }
      };
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(drift);
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      drift();
    }
  </script>
</Base>

<style>
  /* ---------- hero ---------- */
  .story-hero {
    position: relative;
    padding-top: clamp(7rem, 18vh, 10rem);
    padding-bottom: clamp(2rem, 5vh, 4rem);
    min-height: 92svh;
    display: flex;
    border-bottom: 1px solid var(--line);
  }

  .story-hero-inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    width: 100%;
  }

  .story-hero-title {
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    line-height: 0.98;
  }

  .story-hero-sub {
    color: var(--accent);
    font-size: clamp(1rem, 2.4vw, 1.35rem);
  }

  .story-hero-hint {
    margin-top: 1.4rem;
    font-size: 0.62rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--faint);
  }

  /* ---------- shared visual-frame treatment ----------
     every photo/video wears the same film dressing: inner
     letterbox, grain, green-tint grade, corner ticks, slate label */
  .visual-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.82) contrast(1.06) brightness(0.9);
    animation: kenburns 26s ease-in-out infinite alternate;
  }

  @keyframes kenburns {
    from {
      transform: scale(1.03) translate(0, 0);
    }
    to {
      transform: scale(1.12) translate(-1.6%, 1.4%);
    }
  }

  .visual-grade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      /* inner letterbox */
      linear-gradient(to bottom, #000 0 5.5%, transparent 5.5% 94.5%, #000 94.5% 100%),
      /* legibility shade behind the slate */
      linear-gradient(to top, rgba(0, 0, 0, 0.55), transparent 30%),
      /* faint green duotone — ties stock footage to the brand */
      linear-gradient(160deg, rgba(34, 216, 97, 0.07), transparent 45%);
  }

  .visual-grade::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      rgba(34, 216, 97, 0.02) 0 1px,
      transparent 1px 5px
    );
    mix-blend-mode: screen;
  }

  .visual-slate {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(236, 233, 226, 0.72);
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }

  /* corner HUD ticks */
  .chapter-visual::before,
  .chapter-visual::after,
  .cold-frame::before,
  .cold-frame::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    pointer-events: none;
    z-index: 2;
  }

  .chapter-visual::before,
  .cold-frame::before {
    top: 0.7rem;
    left: 0.7rem;
    border-top: 1px solid rgba(236, 233, 226, 0.5);
    border-left: 1px solid rgba(236, 233, 226, 0.5);
  }

  .chapter-visual::after {
    bottom: 0.7rem;
    right: 0.7rem;
    border-bottom: 1px solid rgba(236, 233, 226, 0.5);
    border-right: 1px solid rgba(236, 233, 226, 0.5);
  }

  /* cold frame's bottom-right is taken by the pause control */
  .cold-frame::after {
    top: 0.7rem;
    right: 0.7rem;
    border-top: 1px solid rgba(236, 233, 226, 0.5);
    border-right: 1px solid rgba(236, 233, 226, 0.5);
  }

  /* ---------- cold open ---------- */
  .cold-open {
    padding-block: clamp(1.5rem, 4vh, 3rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .cold-frame {
    position: relative;
    height: min(56vh, calc(100vw / 2.35));
    overflow: hidden;
    background: #0d0d10;
  }

  .cold-toggle {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: rgba(10, 10, 12, 0.55);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--muted);
    cursor: pointer;
    touch-action: manipulation;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .cold-toggle:hover {
    color: var(--text);
    border-color: rgba(255, 255, 255, 0.32);
  }

  .cold-toggle .ct-play {
    display: none;
  }

  .cold-frame.is-paused .ct-pause {
    display: none;
  }

  .cold-frame.is-paused .ct-play {
    display: block;
  }

  .cold-frame.is-paused .visual-media,
  .cold-frame.no-video .visual-media {
    animation-play-state: paused;
  }

  .cold-frame.no-video video {
    display: none;
  }

  /* ---------- chapters ---------- */
  .chapters {
    display: flex;
    flex-direction: column;
  }

  .chapter {
    display: grid;
    gap: 1.4rem;
    padding-block: clamp(2.8rem, 8vh, 5rem);
    border-bottom: 1px solid var(--line);
    align-items: center;
  }

  .chapter:last-child {
    border-bottom: none;
  }

  .chapter-num {
    font-size: clamp(2rem, 6vw, 4.4rem);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 0.9;
    color: rgba(34, 216, 97, 0.22);
    user-select: none;
    order: 1;
  }

  @supports (-webkit-text-stroke: 1px black) {
    .chapter-num {
      color: transparent;
      -webkit-text-stroke: 1px rgba(34, 216, 97, 0.4);
    }
  }

  .chapter-visual {
    position: relative;
    margin: 0;
    aspect-ratio: 16 / 10;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: #0d0d10;
    order: 2;
    will-change: transform;
  }

  .chapter-body {
    max-width: 64ch;
    order: 3;
  }

  .chapter-title {
    font-size: clamp(1.5rem, 3.4vw, 2.3rem);
    margin-bottom: 1.1rem;
  }

  .chapter-body p {
    color: var(--muted);
    line-height: 1.8;
  }

  .chapter-body p + p {
    margin-top: 1.2rem;
  }

  /* iZad's own voice — the pull-line under the narration,
     styled like a documentary transcript quote */
  .chapter-quote {
    margin-top: 1.4rem;
    padding-left: 1.1rem;
    border-left: 2px solid var(--accent);
    font-size: clamp(1.02rem, 1.9vw, 1.22rem);
    line-height: 1.5;
    color: var(--text);
    text-wrap: pretty;
  }

  .chapter-body p:first-of-type::first-letter {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: 2.6em;
    float: left;
    line-height: 0.85;
    padding-right: 0.6rem;
    padding-top: 0.15rem;
    color: var(--accent);
  }

  @media (min-width: 860px) {
    .chapter {
      grid-template-columns: 6rem minmax(0, 5fr) minmax(0, 6fr);
      gap: 2.5rem;
    }

    .chapter-num {
      position: sticky;
      top: 8rem;
      align-self: start;
      order: 1;
    }

    .chapter-body {
      order: 2;
    }

    .chapter-visual {
      order: 3;
    }

    /* alternating sides — even chapters flip text/visual */
    .chapter:nth-of-type(even) .chapter-body {
      order: 3;
    }

    .chapter:nth-of-type(even) .chapter-visual {
      order: 2;
    }
  }

  /* ---------- finale ---------- */
  .story-finale {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 12vh, 8rem);
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, transparent, rgba(34, 216, 97, 0.04));
  }

  .finale-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.14;
    filter: saturate(0.7) brightness(0.7);
    pointer-events: none;
  }

  .story-finale-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2.4rem;
  }

  .finale-quote {
    max-width: 24ch;
    font-size: clamp(1.5rem, 4.4vw, 2.6rem);
    line-height: 1.3;
    color: var(--text);
    text-wrap: balance;
  }

  .finale-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .visual-media {
      animation: none;
    }
  }
</style>
