---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Releases from '../components/Releases.astro';
import Story from '../components/Story.astro';
import Store from '../components/Store.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
---

<Base>
  <Nav />

  <main id="main">
    <Hero />

    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        <span>Lleno de Balas — Out Now</span>
        <span class="serif-accent">De Nueva York Pa' El Universo</span>
        <span>Zaddy Collection</span>
        <span class="serif-accent">Todavía te recuerdo</span>
        <span>Lleno de Balas — Out Now</span>
        <span class="serif-accent">De Nueva York Pa' El Universo</span>
        <span>Zaddy Collection</span>
        <span class="serif-accent">Todavía te recuerdo</span>
      </div>
    </div>

    <Releases />
    <Story />
    <Store />
    <Contact />
  </main>

  <Footer />
  <CartDrawer />

  <script>
    import '../scripts/main.js';
  </script>
</Base>
