---
import * as icons from 'simple-icons';
import { PLATFORMS } from '../data/site.js';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const platforms = limit ? PLATFORMS.slice(0, limit) : PLATFORMS;
---

<ul class="platforms" role="list">
  {
    platforms.map((p) => {
      const icon = p.icon ? (icons as any)[p.icon] : null;
      return (
        <li>
          <a href={p.url} target="_blank" rel="noopener noreferrer" class="platform-chip">
            {icon ? (
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" set:html={`<path d="${icon.path}"/>`} />
            ) : p.name === 'Amazon Music' ? (
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d="M4 18V9.5h2V18H4zm4.7 0V6h2v12h-2zm4.6 0V10.5h2V18h-2zm4.7 0V4.5h2V18h-2z" />
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 2c4.41 0 8 3.59 8 8s-3.59 8-8 8-8-3.59-8-8 3.59-8 8-8zm-2.5 4.5v7l6-3.5-6-3.5z" />
              </svg>
            )}
            <span>{p.name}</span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .platforms { display: flex; flex-wrap: wrap; gap: .55rem; padding: 0; list-style: none; }
  .platform-chip { display: inline-flex; align-items: center; gap: .65rem; min-height: 44px; padding: .65rem .9rem; border: 1px solid var(--line); border-radius: 5px; background: #b6cde506; color: #b9c5d2; box-shadow: inset 0 1px 0 #ffffff04; font-size: .73rem; font-weight: 500; transition: border-color .25s, color .25s, background .25s, box-shadow .25s; }
  .platform-chip:hover { color: var(--text); border-color: #c5d7e35c; background: #b6cde510; box-shadow: inset 0 1px 0 #ffffff08; }
  .platform-chip svg { flex-shrink: 0; transition: color .25s; }
  .platform-chip:hover svg { color: var(--accent); }
  @media (prefers-reduced-motion: reduce) { .platform-chip, .platform-chip svg { transition: none; } }
</style>
