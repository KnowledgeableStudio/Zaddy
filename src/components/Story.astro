---
import Hologram from './Hologram.astro';
---

<section id="story" class="story" aria-labelledby="story-heading">
  <div class="container story-grid">
    <div class="story-side">
      <span class="section-index">02 — The Story</span>
      <h2 id="story-heading" class="display">From the<br />Bronx to<br />the World</h2>
      <p class="story-sub">The story behind the music.</p>

      <div class="story-body">
        <p class="lede">
          My name is iZad Casanova, and I was born in New York City on November 11, 1989. I'm a
          first-generation American, still living in the Bronx, and still chasing a dream. Life
          hasn't made things easy — but I've kept pushing forward.
        </p>
        <p>
          Music is my therapy, and my mission is bigger than me. What follows is the real story —
          struggle, faith, family, and the reason behind every verse.
        </p>
        <a href="/story" class="btn btn-primary story-cta">
          Read the Story
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14m0 0l-6-6m6 6l-6 6" />
          </svg>
        </a>
      </div>

    </div>

    <div class="story-visual">
      <Hologram />
      <blockquote class="story-quote serif-accent">
        “I'm not chasing fame for money — I'm chasing fame to go to war with the system.”
      </blockquote>
    </div>
  </div>
</section>

<style>
  .story {
    padding-block: var(--section-pad);
    position: relative;
    z-index: 1;
    border-block: 1px solid var(--line);
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.015) 40%, transparent);
  }

  .story-grid {
    display: grid;
    gap: 3rem;
  }

  .story-side {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .story-side h2 {
    font-size: clamp(1.7rem, 3.7vw, 2.9rem);
  }

  .story-sub {
    color: var(--muted);
  }

  .story-quote {
    margin-top: 1.6rem;
    padding-left: 1.2rem;
    border-left: 2px solid var(--accent);
    font-size: clamp(0.95rem, 1.6vw, 1.18rem);
    line-height: 1.4;
    color: var(--text);
    text-wrap: balance;
  }

  /* right column is the projection alone — centered against the
     text column so the figure reads as the section's portrait */
  .story-visual {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* holo-wrap's top margin exists to clear the heading on the
     story page — inside this dedicated column it's dead space */
  .story-visual :global(.holo-wrap) {
    margin-top: 0;
  }

  /* figure projects at the anchor's center-x — center the caption
     and quote so they align under it */
  .story-visual :global(.holo-caption) {
    justify-content: center;
  }

  .story-visual .story-quote {
    width: fit-content;
    max-width: 36ch;
    margin-inline: auto;
    margin-top: 2rem;
    padding-left: 0;
    border-left: none;
    text-align: center;
  }

  /* centered accent tick — replaces the left border so the quote
     stays visually centered under the figure */
  .story-visual .story-quote::before {
    content: '';
    display: block;
    width: 2.4rem;
    height: 2px;
    background: var(--accent);
    margin: 0 auto 0.9rem;
  }

  .story-side .story-body {
    margin-top: 1.2rem;
  }

  .story-body {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    max-width: 62ch;
  }

  .story-body p {
    color: var(--muted);
    line-height: 1.75;
  }

  .story-body .lede {
    font-size: 0.92rem;
    color: var(--text);
    line-height: 1.7;
  }

  .story-body .lede::first-letter {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: 2.6em;
    float: left;
    line-height: 0.85;
    padding-right: 0.6rem;
    padding-top: 0.15rem;
    color: var(--accent);
  }

  .story-cta {
    align-self: flex-start;
    margin-top: 0.4rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (min-width: 960px) {
    .story-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 5rem;
      align-items: stretch;
    }
  }
</style>
