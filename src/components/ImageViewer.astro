---
// Global lightbox — opened from .stage-view buttons (data-viewer-*).
// Logic lives in src/scripts/main.js; markup + chrome only here.
---

<div
  id="img-viewer"
  class="viewer"
  role="dialog"
  aria-modal="true"
  aria-label="Image viewer"
  hidden
>
  <div class="viewer-backdrop" data-viewer-close></div>

  <figure class="viewer-shell">
    <img id="viewer-img" src="" alt="" draggable="false" />
    <figcaption id="viewer-caption" class="viewer-caption"></figcaption>
  </figure>

  <button class="btn btn-icon viewer-nav viewer-prev" type="button" data-viewer-prev aria-label="Previous image">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M15 18l-6-6 6-6" />
    </svg>
  </button>
  <button class="btn btn-icon viewer-nav viewer-next" type="button" data-viewer-next aria-label="Next image">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 18l6-6-6-6" />
    </svg>
  </button>

  <button class="btn btn-icon viewer-close" type="button" data-viewer-close aria-label="Close viewer">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <span class="viewer-count" aria-hidden="true"></span>
</div>

<style>
  .viewer {
    position: fixed;
    inset: 0;
    z-index: 140;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 3rem);
  }

  .viewer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.86);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .viewer.show .viewer-backdrop {
    opacity: 1;
  }

  .viewer-shell {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    max-width: min(64rem, 92vw);
    margin: 0;
    overscroll-behavior: contain;
    opacity: 0;
    transform: translateY(18px) scale(0.97);
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }

  .viewer.show .viewer-shell {
    opacity: 1;
    transform: none;
  }

  .viewer-shell img {
    max-width: 100%;
    max-height: 76svh;
    object-fit: contain;
    border-radius: 14px;
    border: 1px solid var(--line-strong);
    background: rgba(0, 0, 0, 0.4);
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.7);
    touch-action: pan-y; /* horizontal swipes are ours — vertical stays native */
    cursor: grab;
  }

  .viewer-shell img:active {
    cursor: grabbing;
  }

  .viewer-caption {
    font-family: var(--font-display);
    font-stretch: 118%;
    font-weight: 800;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .viewer-nav,
  .viewer-close {
    position: absolute;
    z-index: 2;
    background: rgba(10, 10, 12, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .viewer-close {
    top: 1rem;
    right: 1rem;
  }

  .viewer-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 2.9rem;
    height: 2.9rem;
  }

  .viewer-prev {
    left: 1rem;
  }

  .viewer-next {
    right: 1rem;
  }

  .viewer-count {
    position: absolute;
    bottom: 1.15rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .viewer-backdrop,
    .viewer-shell {
      transition: none;
    }
  }
</style>
