---
import Platforms from './Platforms.astro';
import { ARTIST } from '../data/site.js';
---

<section id="contact" class="section" aria-labelledby="contact-heading" data-motion-scene>
  <div class="contact-field" aria-hidden="true"><span data-ambient></span><span data-ambient></span><span data-ambient></span></div>
  <div class="container">
    <div class="section-head reveal">
      <span class="section-index">04 — Contact</span>
      <h2 id="contact-heading">Get In<br /><span>Touch</span></h2>
      <p>For bookings, collaborations, and inquiries.</p>
      <div class="contact-orbit" aria-hidden="true"><i data-ambient></i><i data-ambient></i><i data-ambient></i></div>
    </div>

    <div class="contact-grid">
      <div class="contact-card reveal" data-depth>
        <div class="contact-face" data-depth-surface>
        <svg class="contact-symbol" viewBox="0 0 100 100" fill="none" aria-hidden="true"><path d="M12 26h76v50H12zM12 26l38 29 38-29M12 76l27-31m49 31L61 45" stroke="currentColor" stroke-width="1" /></svg>
        <h3>Bookings &amp; Management</h3>
        <p>For professional inquiries and booking requests — email is the fastest way to reach the team.</p>
        <a class="contact-email" href={`mailto:${ARTIST.email}`}>
          <span class="contact-email-addr">{ARTIST.email}</span>
          <svg class="contact-email-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7M9 7h8v8" />
          </svg>
        </a>
        </div>
      </div>

      <div class="contact-card reveal" data-delay="1" data-depth>
        <div class="contact-face" data-depth-surface>
        <svg class="contact-symbol" viewBox="0 0 100 100" fill="none" aria-hidden="true"><circle cx="50" cy="50" r="37" stroke="currentColor" /><ellipse cx="50" cy="50" rx="18" ry="37" stroke="currentColor" /><path d="M14 39h72M14 61h72M50 13v74" stroke="currentColor" /></svg>
        <h3>All Platforms</h3>
        <p>Stream, follow, and connect on every platform.</p>
        <Platforms />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    position: relative;
    z-index: 1;
    padding-block: var(--section-pad);
    border-top: 1px solid #ccd5e138;
    background: linear-gradient(180deg, #070a0e30, #080b10ee);
    overflow: clip;
  }
  .contact-field { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at 82% 22%, #b4bbc624, transparent 42%); }
  .contact-field span { position: absolute; top: 0; bottom: 0; width: 1px; opacity: .35; background: linear-gradient(transparent, #ccd5e13b, transparent); }
  .contact-field span:nth-child(1) { left: 25%; }
  .contact-field span:nth-child(2) { left: 50%; }
  .contact-field span:nth-child(3) { left: 75%; }
  .contact-field span::after { content: ''; position: absolute; top: 0; width: 2px; height: 15%; background: linear-gradient(transparent, #d1dae6, transparent); animation: connection-flow 16s linear infinite; will-change: transform; }
  .contact-field span:nth-child(2)::after { animation-delay: -3s; }
  .contact-field span:nth-child(3)::after { animation-delay: -6s; }
  .section > .container { position: relative; z-index: 1; }
  .section-head {
    position: relative;
    display: grid;
    gap: 1.4rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  .section-head h2 {
    font-size: clamp(3.4rem, 8vw, 7rem);
    font-stretch: 105%;
    letter-spacing: -0.06em;
    line-height: 0.94;
  }
  .section-head h2 span { color: #d4ddea; background: linear-gradient(170deg, #fbfdff 8%, #9dabb8 48%, #e5edf2 75%); background-clip: text; -webkit-text-fill-color: transparent; }
  .section-head p { font-size: 1rem; max-width: 27ch; color: #bbc3ce; }
  .contact-orbit { position: absolute; top: 0; right: 1rem; width: clamp(9rem, 18vw, 17rem); aspect-ratio: 1; display: grid; place-items: center; pointer-events: none; }
  .contact-orbit i { position: absolute; inset: 7%; border-radius: 50%; background: conic-gradient(from 15deg, #17202c, #d5dde5 12%, #fbfdff 16%, #525f6c 28%, #0c1018 40%, #788896 55%, #dce5ed 68%, #25303c 80%, #17202c); mask: radial-gradient(transparent 63%, #000 64% 69%, transparent 70%); animation: network-orbit 45s linear infinite; }
  .contact-orbit i:first-child { inset: 0; animation-duration: 85s; scale: 1 .8; rotate: -18deg; }
  .contact-orbit i:nth-child(2) { rotate: 48deg; scale: 1 .48; animation-delay: -6s; }
  .contact-orbit i:nth-child(3) { rotate: -48deg; scale: 1 .48; animation-direction: reverse; animation-delay: -14s; }
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }
  .contact-card {
    content-visibility: auto;
    contain-intrinsic-size: auto 420px;
    position: relative;
    min-width: 0;
  }
  .contact-face { position: relative; display: flex; flex-direction: column; align-items: flex-start; height: 100%; min-height: 23rem; padding: clamp(1.5rem, 3.5vw, 3rem); gap: 1.35rem; border: 1px solid #d1dae62e; border-radius: 24px; background: radial-gradient(ellipse at var(--light-x, 25%) var(--light-y, 0%), #e3eff91c, transparent 65%), linear-gradient(140deg, #1a2029f5, #090d13f8 68%); box-shadow: inset 0 1px #dfe8f53d, inset 0 -1px #000c, 0 28px 65px #0007; overflow: hidden; }
  .contact-face::before { content: ''; position: absolute; top: 0; left: 10%; width: 80%; height: 2px; background: linear-gradient(90deg, transparent, #e0eaf36e, transparent); pointer-events: none; }
  .contact-face::after { content: ''; position: absolute; inset: 5px; border: 1px solid #f1f5f907; border-radius: 20px; pointer-events: none; }
  .contact-symbol { position: absolute; top: 1.4rem; right: 1.6rem; width: 8rem; height: 8rem; color: #ccd5e11e; pointer-events: none; }
  .contact-card h3 {
    position: relative;
    font-family: var(--font-display);
    font-stretch: 110%;
    font-weight: 650;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }
  .contact-card p {
    position: relative;
    max-width: 43ch;
    color: #b9c1cc;
    line-height: 1.8;
  }
  .contact-email {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 100%;
    min-height: 48px;
    margin-top: auto;
    padding-block: 1rem 0.6rem;
    border-bottom: 1px solid #d2dbe746;
    font-weight: 550;
    font-size: clamp(0.86rem, 1.5vw, 1.2rem);
    letter-spacing: -0.025em;
    color: #e2ebf8;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .contact-email-addr { overflow-wrap: anywhere; }
  .contact-email-arrow { flex-shrink: 0; color: #b7d4e5; }
  .contact-email:hover { color: #f1f4f7; border-color: #b7d4e5; }
  .contact-face :global(.platforms) { position: relative; gap: .65rem; }
  .contact-face :global(.platform-chip) { background: linear-gradient(145deg, #ffffff08, #0002); border-color: #d2dbe729; border-radius: 9px; box-shadow: inset 0 1px #dee7f40a, 0 3px 6px #0002; }
  .contact-face :global(.platform-chip:hover) { color: #e6f0fe; background: #c4ccd71b; box-shadow: 0 0 20px #b1b8c314; border-color: #d1dae697; }
  @keyframes network-orbit { from { rotate: 0deg; } to { rotate: 360deg; } }
  @keyframes connection-flow { to { transform: translateY(733.33%); } }
  @media (min-width: 860px) {
    .section-head { grid-template-columns: 1fr 1fr; }
    .section-head .section-index { grid-column: 1 / -1; }
    .section-head p { align-self: end; padding-bottom: 0.5rem; }
    .contact-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 859px) { .contact-orbit { top: 1rem; right: 0; opacity: .6; } .section-head h2 { position: relative; z-index: 1; } }
  @media (max-width: 440px) { .contact-orbit { width: 7.5rem; top: 2rem; opacity: .3; } .contact-symbol { width: 6rem; opacity: .7; } }
  :global(html[data-motion-paused='true']) .contact-field span::after,
  :global(html[data-motion-paused='true']) .contact-orbit i { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) {
    .contact-email { transition: none; }
    .contact-field span::after, .contact-orbit i { animation: none; }
  }
</style>
