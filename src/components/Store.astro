---
import { Image } from 'astro:assets';
import zaddyWordmark from '../assets/zaddy-wordmark.png';
import maskSignature from '../assets/mask-signature.png';
import maskUrban from '../assets/mask-urban.png';
import maskElite from '../assets/mask-elite.png';
import teeConcretePoetry from '../assets/tee-concrete-poetry.png';
import teeDestiny from '../assets/tee-destiny.png';
import teeAfterHours from '../assets/tee-after-hours.png';
import hoodieAfterMidnight from '../assets/hoodie-after-midnight.png';
import hoodieConcretePoet from '../assets/hoodie-concrete-poet.png';
import hoodieGhettoGarden from '../assets/hoodie-ghetto-garden.png';
import jeansRoseRust from '../assets/jeans-rose-rust.png';
import jeansIcedGraffiti from '../assets/jeans-iced-graffiti.png';
import jeansSubwayMosaic from '../assets/jeans-subway-mosaic.png';
import { PRODUCTS, UPCOMING, UPCOMING_HOODIES, UPCOMING_JEANS } from '../data/site.js';

const productArt = {
  'mask-signature': maskSignature,
  'mask-urban': maskUrban,
  'mask-elite': maskElite,
} as const;

const upcomingArt = {
  'tee-concrete-poetry': teeConcretePoetry,
  'tee-destiny': teeDestiny,
  'tee-after-hours': teeAfterHours,
} as const;

const hoodieArt = {
  'hoodie-after-midnight': hoodieAfterMidnight,
  'hoodie-concrete-poet': hoodieConcretePoet,
  'hoodie-ghetto-garden': hoodieGhettoGarden,
} as const;

const jeansArt = {
  'jeans-rose-rust': jeansRoseRust,
  'jeans-iced-graffiti': jeansIcedGraffiti,
  'jeans-subway-mosaic': jeansSubwayMosaic,
} as const;
---

<section id="store" class="section" aria-labelledby="store-heading">
  <div class="container">
    <div class="section-head reveal">
      <span class="section-index">03 — Official Merch</span>
      <div class="store-title-row">
        <Image
          src={zaddyWordmark}
          alt="Zaddy Collection logo"
          class="store-logo"
          widths={[360, 640]}
          sizes="(max-width: 720px) 70vw, 320px"
          loading="lazy"
        />
      </div>
      <p>Limited edition merchandise. Every piece is a statement.</p>
      <button class="btn btn-sm" type="button" data-notify>Notify Me About New Drops</button>
    </div>

    <div class="product-grid">
      {
        PRODUCTS.map((product, i) => (
          <article class="product-card reveal" data-delay={String(i)} style={`--card-i:${i}`}>
            <span class="card-scan" aria-hidden="true"></span>
            <span class="card-frame" aria-hidden="true"></span>
            {product.badge && <span class="product-badge">{product.badge}</span>}
            <div class="product-stage">
              <Image
                src={productArt[product.image]}
                alt={product.name}
                widths={[320, 560]}
                sizes="(max-width: 720px) 80vw, 300px"
                loading="lazy"
              />
            </div>
            <div class="product-info">
              <h3>{product.name}</h3>
              <p>{product.description}</p>
              <div class="product-buy">
                <span class="product-price">${product.price.toFixed(2)}</span>
                <button class="btn btn-primary btn-sm" type="button" data-add-to-cart={product.id}>
                  Add to Cart
                </button>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="upcoming-head reveal">
      <span class="section-index">Next Drop</span>
      <h3 class="upcoming-title">Coming <span class="serif-accent">Soon</span></h3>
      <p class="upcoming-sub">Three heavyweight tees in the works. Lock in early — these won't sit.</p>
    </div>

    <div class="product-grid">
      {
        UPCOMING.map((product, i) => (
          <article class="product-card reveal" data-delay={String(i)} style={`--card-i:${i + 3}`}>
            <span class="card-scan" aria-hidden="true"></span>
            <span class="card-frame" aria-hidden="true"></span>
            <span class="product-badge">Coming Soon</span>
            <div class="product-stage product-stage--photo">
              <Image
                src={upcomingArt[product.image]}
                alt={`${product.name} — front and back mockup`}
                widths={[480, 800]}
                sizes="(max-width: 720px) 90vw, 340px"
                loading="lazy"
              />
            </div>
            <div class="product-info">
              <h3>{product.name}</h3>
              <p>{product.description}</p>
              <div class="product-buy">
                <span class="product-price">${product.price.toFixed(2)}</span>
                <button class="btn btn-sm" type="button" data-notify>
                  Notify Me
                </button>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="upcoming-head reveal">
      <span class="section-index">Next Drop — 02</span>
      <h3 class="upcoming-title">Heavyweight <span class="serif-accent">Hoodies</span></h3>
      <p class="upcoming-sub">Acid-washed fleece, oversized fit. Numbered pieces — no restocks.</p>
    </div>

    <div class="product-grid">
      {
        UPCOMING_HOODIES.map((product, i) => (
          <article class="product-card reveal" data-delay={String(i)} style={`--card-i:${i + 6}`}>
            <span class="card-scan" aria-hidden="true"></span>
            <span class="card-frame" aria-hidden="true"></span>
            <span class="product-badge">Coming Soon</span>
            <div class="product-stage product-stage--photo">
              <Image
                src={hoodieArt[product.image]}
                alt={`${product.name} — front and back mockup`}
                widths={[480, 800]}
                sizes="(max-width: 720px) 90vw, 340px"
                loading="lazy"
              />
            </div>
            <div class="product-info">
              <h3>{product.name}</h3>
              <p>{product.description}</p>
              <div class="product-buy">
                <span class="product-price">${product.price.toFixed(2)}</span>
                <button class="btn btn-sm" type="button" data-notify>
                  Notify Me
                </button>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="upcoming-head reveal">
      <span class="section-index">Next Drop — 03</span>
      <h3 class="upcoming-title">Statement <span class="serif-accent">Denim</span></h3>
      <p class="upcoming-sub">Distressed, patched, engineered — three cuts built for the city.</p>
    </div>

    <div class="product-grid">
      {
        UPCOMING_JEANS.map((product, i) => (
          <article class="product-card reveal" data-delay={String(i)} style={`--card-i:${i + 9}`}>
            <span class="card-scan" aria-hidden="true"></span>
            <span class="card-frame" aria-hidden="true"></span>
            <span class="product-badge">Coming Soon</span>
            <div class="product-stage product-stage--photo product-stage--tall">
              <Image
                src={jeansArt[product.image]}
                alt={`${product.name} — front and back mockup`}
                widths={[480, 800]}
                sizes="(max-width: 720px) 90vw, 340px"
                loading="lazy"
              />
            </div>
            <div class="product-info">
              <h3>{product.name}</h3>
              <p>{product.description}</p>
              <div class="product-buy">
                <span class="product-price">${product.price.toFixed(2)}</span>
                <button class="btn btn-sm" type="button" data-notify>
                  Notify Me
                </button>
              </div>
            </div>
          </article>
        ))
      }
    </div>

  </div>
</section>

<style>
  .section {
    padding-block: var(--section-pad);
    position: relative;
    z-index: 1;
  }

  .store-title-row {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .store-logo {
    width: clamp(170px, 24vw, 270px);
    height: auto;
    filter: drop-shadow(0 10px 30px rgba(0, 0, 0, 0.5));
  }

  .product-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
    max-width: 66rem;
  }

  /* layout only — the holo surface lives in the global card system */
  .product-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 3;
    font-size: 0.56rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    background: rgba(34, 216, 97, 0.12);
    color: var(--accent);
    border: 1px solid rgba(34, 216, 97, 0.45);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: 0 0 18px rgba(34, 216, 97, 0.15);
  }

  .product-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 14rem;
    background:
      radial-gradient(60% 55% at 50% 62%, rgba(34, 216, 97, 0.11), transparent 70%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent 30%),
      linear-gradient(180deg, var(--surface-2), transparent);
    border-bottom: 1px solid rgba(34, 216, 97, 0.1);
  }

  .product-stage img {
    height: 11.5rem;
    width: auto;
    max-width: 80%;
    object-fit: contain;
    filter:
      drop-shadow(0 24px 34px rgba(0, 0, 0, 0.55))
      drop-shadow(0 0 26px rgba(34, 216, 97, 0.14));
    transform: rotate(3deg);
    transition: transform 0.5s var(--ease-spring), filter 0.4s ease;
  }

  .product-card:hover .product-stage img {
    transform: rotate(0deg) scale(1.04);
    filter:
      drop-shadow(0 24px 34px rgba(0, 0, 0, 0.55))
      drop-shadow(0 0 40px rgba(34, 216, 97, 0.28));
  }

  .upcoming-head {
    margin-top: clamp(2.4rem, 5vw, 3.6rem);
    padding-top: clamp(1.8rem, 4vw, 2.8rem);
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-bottom: clamp(1.6rem, 4vw, 2.4rem);
  }

  .upcoming-title {
    font-family: var(--font-display);
    font-stretch: 120%;
    font-weight: 800;
    font-size: clamp(1.3rem, 3vw, 2rem);
    text-transform: uppercase;
    letter-spacing: -0.015em;
    line-height: 0.95;
  }

  .upcoming-title .serif-accent {
    text-transform: none;
    letter-spacing: 0;
    color: var(--accent);
  }

  .upcoming-sub {
    color: var(--muted);
    font-size: 0.78rem;
    max-width: 46ch;
  }

  /* photo mockups fill the stage edge-to-edge like a lookbook frame */
  .product-stage--photo {
    position: relative;
    height: auto;
    aspect-ratio: 4 / 3;
    padding: 0;
  }

  .product-stage--photo::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(10, 10, 12, 0.22),
      transparent 24%,
      transparent 76%,
      rgba(10, 10, 12, 0.38)
    );
  }

  .product-stage--photo img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transform: none;
    filter: saturate(0.96) contrast(1.02);
  }

  .product-card:hover .product-stage--photo img {
    transform: scale(1.045);
    filter: saturate(1) contrast(1.03);
  }

  /* portrait spec-sheet mockups (jeans) — taller frame, no crop */
  .product-stage--tall {
    aspect-ratio: 4 / 5;
  }

  .product-info {
    padding: 1.15rem;
  }

  .product-info h3 {
    font-family: var(--font-display);
    font-stretch: 118%;
    font-weight: 800;
    font-size: 0.98rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .product-info p {
    color: var(--muted);
    font-size: 0.72rem;
    margin-top: 0.4rem;
  }

  .product-buy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.1rem;
  }

  .product-price {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    font-variant-numeric: tabular-nums;
  }

  /* auto-fit: three columns on desktop, two on tablets, one on phones —
     reflows by available width instead of a hard breakpoint */
  .product-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15.5rem), 1fr));
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-stage img {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  // Subtle 3D tilt — the card leans toward the pointer like a projected plane.
  // Pointer-fine devices only; disabled under prefers-reduced-motion.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = window.matchMedia('(pointer: fine)').matches;

  if (!reduceMotion && finePointer) {
    document.querySelectorAll('.product-card').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const rx = ((e.clientY - r.top) / r.height - 0.5) * -5;
        const ry = ((e.clientX - r.left) / r.width - 0.5) * 5;
        card.style.transform = `perspective(900px) rotateX(${rx}deg) rotateY(${ry}deg) translateY(-4px)`;
      });
      card.addEventListener('pointerleave', () => {
        card.style.transform = '';
      });
    });
  }
</script>
