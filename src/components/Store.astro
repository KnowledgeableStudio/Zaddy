---
import { getImage, Image } from 'astro:assets';
import zaddyWordmark from '../assets/zaddy-wordmark.png';
import maskSignature from '../assets/mask-signature.png';
import maskUrban from '../assets/mask-urban.png';
import maskElite from '../assets/mask-elite.png';
import teeConcretePoetry from '../assets/tee-concrete-poetry.png';
import teeDestiny from '../assets/tee-destiny.png';
import teeAfterHours from '../assets/tee-after-hours.png';
import hoodieAfterMidnight from '../assets/hoodie-after-midnight.png';
import hoodieConcretePoet from '../assets/hoodie-concrete-poet.png';
import hoodieGhettoGarden from '../assets/hoodie-ghetto-garden.png';
import jeansRoseRust from '../assets/jeans-rose-rust.png';
import jeansIcedGraffiti from '../assets/jeans-iced-graffiti.png';
import jeansSubwayMosaic from '../assets/jeans-subway-mosaic.png';
import { PRODUCTS, UPCOMING, UPCOMING_HOODIES, UPCOMING_JEANS } from '../data/site.js';

const productArt = {
  'mask-signature': maskSignature,
  'mask-urban': maskUrban,
  'mask-elite': maskElite,
} as const;

const upcomingArt = {
  'tee-concrete-poetry': teeConcretePoetry,
  'tee-destiny': teeDestiny,
  'tee-after-hours': teeAfterHours,
} as const;

const hoodieArt = {
  'hoodie-after-midnight': hoodieAfterMidnight,
  'hoodie-concrete-poet': hoodieConcretePoet,
  'hoodie-ghetto-garden': hoodieGhettoGarden,
} as const;

const jeansArt = {
  'jeans-rose-rust': jeansRoseRust,
  'jeans-iced-graffiti': jeansIcedGraffiti,
  'jeans-subway-mosaic': jeansSubwayMosaic,
} as const;

// ~1200px webp variants for the lightbox — raw PNGs are ~3MB each
const allArt = { ...productArt, ...upcomingArt, ...hoodieArt, ...jeansArt };
const viewerSrc = Object.fromEntries(
  await Promise.all(
    Object.entries(allArt).map(async ([key, img]) => [
      key,
      (await getImage({ src: img, width: 1400, format: 'webp' })).src,
    ])
  )
);
---

<section id="store" class="section" aria-labelledby="store-heading" data-motion-scene>
  <div class="container">
    <div class="section-head store-intro reveal">
      <div class="store-brand">
      <span class="section-index">03 — Official Merch</span>
      <h2 id="store-heading" class="store-title-row">
        <Image
          src={zaddyWordmark}
          alt="Zaddy Collection logo"
          class="store-logo"
          widths={[360, 640]}
          sizes="(max-width: 600px) 58vw, 310px"
          loading="lazy"
        />
      </h2>
      </div>
      <div class="store-intro-copy">
      <p>Limited edition merchandise. Every piece is a statement.</p>
      <button class="btn btn-sm" type="button" data-notify>Notify Me About New Drops</button>
      </div>
    </div>

    <nav class="collection-tabs reveal" aria-label="Browse collections">
      <a href="#collection-masks">Masks <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor"/></svg></a>
      <a href="#collection-tees">Tees <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor"/></svg></a>
      <a href="#collection-hoodies">Hoodies <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor"/></svg></a>
      <a href="#collection-denim">Denim <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor"/></svg></a>
    </nav>

    <div id="collection-masks" class="collection-lead reveal">
      <h3>Masks</h3>
    </div>

    <div class="product-grid" role="group" aria-label="Masks">
      {
        PRODUCTS.map((product, i) => (
          <article class="product-card product-card--mask reveal" data-depth data-motion-scene data-delay={String(i)} style={`--card-i:${i}`}>
            {product.badge && <span class="product-badge">{product.badge}</span>}
            <div class="product-stage" data-depth-surface>
              <div class="chamber-world" aria-hidden="true">
                <span class="chamber-orbit chamber-orbit--back" data-ambient></span>
                <span class="chamber-plinth"></span>
              </div>
              <span class="zoom-cue" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M7 3H3v4m10-4h4v4M3 13v4h4m10-4v4h-4"/></svg></span>
              <button
                class="stage-view"
                type="button"
                data-viewer-group="masks"
                data-viewer-src={viewerSrc[product.image]}
                data-viewer-alt={product.name}
                aria-label={`Enlarge ${product.name} image`}
              >
                <Image
                  src={productArt[product.image]}
                  data-float
                  alt=""
                  widths={[320, 560]}
                  sizes="(max-width: 359px) 90vw, (max-width: 760px) 44vw, 330px"
                  loading="lazy"
                />
              </button>
            </div>
            <div class="product-info">
              <h3>{product.name}</h3>
              <p>{product.description}</p>
              <div class="product-buy">
                <span class="product-price">${product.price.toFixed(2)}</span>
                <button class="btn btn-primary btn-sm" type="button" data-add-to-cart={product.id}>
                  Add to Cart
                </button>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div id="collection-tees" class="upcoming-head reveal">
      <span class="section-index">Next Drop</span>
      <h3 class="upcoming-title">Coming <span class="serif-accent">Soon</span></h3>
      <p class="upcoming-sub">Three heavyweight tees in the works. Lock in early — these won't sit.</p>
    </div>

    <div class="product-grid" role="group" aria-label="Upcoming tees">
      {
        UPCOMING.map((product, i) => (
          <article class="product-card product-card--upcoming reveal" data-depth data-motion-scene data-delay={String(i)} style={`--card-i:${i + 3}`}>
            <span class="product-badge">Coming Soon</span>
            <div class="product-stage product-stage--photo" data-depth-surface>
              <span class="zoom-cue" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M7 3H3v4m10-4h4v4M3 13v4h4m10-4v4h-4"/></svg></span>
              <button
                class="stage-view"
                type="button"
                data-viewer-group="tees"
                data-viewer-src={viewerSrc[product.image]}
                data-viewer-alt={product.name}
                aria-label={`Enlarge ${product.name} image`}
              >
                <Image
                  src={upcomingArt[product.image]}
                  alt=""
                  widths={[480, 800]}
                  sizes="(max-width: 359px) 90vw, (max-width: 760px) 44vw, 330px"
                  loading="lazy"
                />
              </button>
            </div>
            <div class="product-info">
              <h3>{product.name}</h3>
              <p>{product.description}</p>
              <div class="product-buy">
                <button class="btn btn-sm" type="button" data-notify>
                  Notify Me
                </button>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div id="collection-hoodies" class="upcoming-head reveal">
      <span class="section-index">Next Drop — 02</span>
      <h3 class="upcoming-title">Heavyweight <span class="serif-accent">Hoodies</span></h3>
      <p class="upcoming-sub">Acid-washed fleece, oversized fit. Numbered pieces — no restocks.</p>
    </div>

    <div class="product-grid" role="group" aria-label="Upcoming hoodies">
      {
        UPCOMING_HOODIES.map((product, i) => (
          <article class="product-card product-card--upcoming reveal" data-depth data-motion-scene data-delay={String(i)} style={`--card-i:${i + 6}`}>
            <span class="product-badge">Coming Soon</span>
            <div class="product-stage product-stage--photo" data-depth-surface>
              <span class="zoom-cue" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M7 3H3v4m10-4h4v4M3 13v4h4m10-4v4h-4"/></svg></span>
              <button
                class="stage-view"
                type="button"
                data-viewer-group="hoodies"
                data-viewer-src={viewerSrc[product.image]}
                data-viewer-alt={product.name}
                aria-label={`Enlarge ${product.name} image`}
              >
                <Image
                  src={hoodieArt[product.image]}
                  alt=""
                  widths={[480, 800]}
                  sizes="(max-width: 359px) 90vw, (max-width: 760px) 44vw, 330px"
                  loading="lazy"
                />
              </button>
            </div>
            <div class="product-info">
              <h3>{product.name}</h3>
              <p>{product.description}</p>
              <div class="product-buy">
                <button class="btn btn-sm" type="button" data-notify>
                  Notify Me
                </button>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div id="collection-denim" class="upcoming-head reveal">
      <span class="section-index">Next Drop — 03</span>
      <h3 class="upcoming-title">Statement <span class="serif-accent">Denim</span></h3>
      <p class="upcoming-sub">Distressed, patched, engineered — three cuts built for the city.</p>
    </div>

    <div class="product-grid" role="group" aria-label="Upcoming jeans">
      {
        UPCOMING_JEANS.map((product, i) => (
          <article class="product-card product-card--upcoming reveal" data-depth data-motion-scene data-delay={String(i)} style={`--card-i:${i + 9}`}>
            <span class="product-badge">Coming Soon</span>
            <div class="product-stage product-stage--photo product-stage--tall" data-depth-surface>
              <span class="zoom-cue" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M7 3H3v4m10-4h4v4M3 13v4h4m10-4v4h-4"/></svg></span>
              <button
                class="stage-view"
                type="button"
                data-viewer-group="jeans"
                data-viewer-src={viewerSrc[product.image]}
                data-viewer-alt={product.name}
                aria-label={`Enlarge ${product.name} image`}
              >
                <Image
                  src={jeansArt[product.image]}
                  alt=""
                  widths={[480, 800]}
                  sizes="(max-width: 359px) 90vw, (max-width: 760px) 44vw, 330px"
                  loading="lazy"
                />
              </button>
            </div>
            <div class="product-info">
              <h3>{product.name}</h3>
              <p>{product.description}</p>
              <div class="product-buy">
                <button class="btn btn-sm" type="button" data-notify>
                  Notify Me
                </button>
              </div>
            </div>
          </article>
        ))
      }
    </div>

  </div>
</section>

<style>
  .section { padding-block: clamp(3.5rem, 6vw, 6rem); position: relative; z-index: 1; }
  .container { max-width: calc(65rem + var(--gutter) + var(--gutter)); }
  .store-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; gap: 1.5rem 3rem; margin-bottom: 1.8rem; }
  .store-title-row { margin-top: .7rem; line-height: 1; }
  .store-logo { width: min(100%, 19.5rem); height: auto; }
  .store-intro-copy { padding-bottom: .1rem; }
  .store-intro-copy > p { color: #b6c0cb; font-size: .93rem; max-width: 37ch; }
  .store-intro-copy > button { margin-top: .95rem; border-radius: 6px; background: #141b24; border-color: #ffffff29; color: #e3e9ee; box-shadow: none; }
  .collection-tabs { display: flex; gap: .35rem; margin-bottom: 1.65rem; padding-bottom: .8rem; border-bottom: 1px solid #ffffff18; }
  .collection-tabs a { display: inline-flex; align-items: center; justify-content: center; gap: .7rem; min-height: 44px; padding: .65rem 1.1rem; border: 1px solid #ffffff1c; border-radius: 6px; background: #111720c9; color: #d7e0e8; font: 600 .75rem/1.3 var(--font-body); transition: background .2s, border-color .2s; }
  .collection-tabs a svg { color: #9caebc; }
  .collection-tabs a:hover, .collection-tabs a:focus-visible { background: #222d3b; border-color: #ffffff4d; color: #fff; }
  .collection-lead { margin: 0 0 1rem; scroll-margin-top: 7rem; }
  .collection-lead h3 { font: 650 1.05rem/1.2 var(--font-display); letter-spacing: .005em; color: #dce4ec; }
  .product-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.15rem; align-items: stretch; }
  .product-card { content-visibility: auto; contain-intrinsic-size: auto 500px; position: relative; display: flex; flex-direction: column; min-width: 0; isolation: isolate; overflow: hidden; border: 1px solid #cedcec28; border-radius: 10px; background: #10161f; box-shadow: inset 0 1px #ffffff0d, 0 18px 32px -20px #000c, 0 3px 0 #02070bb3; transition: border-color .3s, box-shadow .3s; }
  .product-card::before { content: ''; position: absolute; z-index: 5; inset: 0; pointer-events: none; border-radius: inherit; background: radial-gradient(circle at var(--light-x, 50%) var(--light-y, 20%), #deedff12, transparent 47%); opacity: .35; transition: opacity .3s; }
  .product-card::after { content: ''; position: absolute; z-index: 5; top: 0; left: 10%; right: 10%; height: 1px; pointer-events: none; background: linear-gradient(90deg, transparent, #d4e3f25c, transparent); }
  .product-card:hover, .product-card:focus-within { border-color: #d8e9fc61; box-shadow: inset 0 1px #ffffff14, 0 22px 40px -21px #000e, 0 4px 0 #02070bb3; }
  .product-card:hover::before, .product-card:focus-within::before { opacity: 1; }
  .product-badge { position: absolute; top: .75rem; right: .75rem; z-index: 7; padding: .34rem .55rem; border: 1px solid #ffffff2b; border-radius: 4px; background: #101620ed; color: #e1eaf1; font: 600 .58rem/1.2 var(--font-body); letter-spacing: .01em; pointer-events: none; }
  .product-stage { position: relative; display: grid; place-items: center; aspect-ratio: 1.16; overflow: hidden; border-bottom: 1px solid #ffffff14; background: radial-gradient(ellipse at 50% 30%, #3947565e, transparent 61%), linear-gradient(145deg, #1a232f, #101720 57%, #090f16); transform-origin: center 64%; }
  .product-stage::after { content: ''; position: absolute; z-index: 4; inset: 0; pointer-events: none; background: linear-gradient(130deg, #fff6 0%, transparent 1.1%, transparent 82%, #cbd9f006 100%); opacity: .19; }
  .chamber-world { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .chamber-world::before { content: ''; position: absolute; left: 12%; right: 12%; bottom: 9%; height: 32%; border: 1px solid #d7e4f529; border-radius: 8px; transform: perspective(370px) rotateX(61deg); transform-origin: center bottom; background: linear-gradient(120deg, #465160, #202a37 25%, #18212c 70%, #7c899433); box-shadow: 0 12px 0 -2px #0a1018, 0 13px 0 -2px #b7cce632, 0 18px 20px #0007, inset 0 1px #e1eaff40; }
  .chamber-orbit { position: absolute; left: 20%; top: 10%; width: 60%; aspect-ratio: 1; border: 1px solid #bfd6ec23; border-radius: 50%; transform: perspective(500px) rotateY(-24deg) rotateX(9deg); animation: object-orbit 20s ease-in-out infinite; }
  .chamber-orbit::before { content: ''; position: absolute; inset: -1px; border: 1px solid transparent; border-left-color: #daeafa83; border-right-color: #daeafa33; border-radius: inherit; }
  .chamber-plinth { position: absolute; left: 24%; right: 24%; bottom: 15%; height: 5%; border-radius: 50%; background: #03090fd9; filter: blur(7px); }
  .zoom-cue { position: absolute; z-index: 6; right: .8rem; bottom: .8rem; pointer-events: none; color: #b5c5d1; }
  /* Fixed tracks let artwork shrink inside the padded stage instead of sizing the row intrinsically. */
  .stage-view { position: absolute; z-index: 3; inset: 0; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(0, 1fr); place-items: center; width: 100%; height: 100%; min-width: 0; min-height: 44px; padding: 1.8rem 1.55rem 2rem; background: transparent; cursor: zoom-in; }
  .stage-view:focus-visible { outline-offset: -5px; }
  .product-stage img { width: 100%; height: 100%; min-width: 0; min-height: 0; max-width: 100%; max-height: 100%; object-fit: contain; filter: drop-shadow(0 17px 12px #000a); --float-duration: 7s; --float-delay: calc(var(--card-i) * -.8s); }
  .product-stage--photo { aspect-ratio: 1.15; background: #141c26; }
  .product-stage--photo .stage-view { padding: 2rem .7rem .7rem; }
  .product-stage--photo img { object-fit: contain; filter: none; }
  .product-stage--photo .zoom-cue { right: .45rem; bottom: .45rem; padding: .2rem; border-radius: 3px; background: #080e17bd; }
  .product-stage--tall { aspect-ratio: .94; }
  .product-info { position: relative; display: flex; flex-direction: column; flex: 1; padding: 1.1rem; z-index: 2; background: #101720; }
  .product-info h3 { font: 650 1.04rem/1.25 var(--font-display); letter-spacing: -.015em; color: #f1f4f7; }
  .product-info p { margin-top: .5rem; margin-bottom: 1rem; color: #b2bdc9; font-size: .8rem; line-height: 1.55; }
  .product-buy { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .65rem; margin-top: auto; }
  .product-buy .btn { min-height: 44px; padding: .65rem .95rem; border: 1px solid #ffffff2b; border-radius: 6px; clip-path: none; background: #1b2531; color: #edf2f6; font-size: .73rem; font-weight: 600; letter-spacing: 0; box-shadow: none; }
  .product-buy .btn-primary { background: #edf2f6; color: #101720; border-color: #edf2f6; }
  .product-buy .btn:hover { background: #2b3949; border-color: #b7d4e570; color: #fff; box-shadow: none; }
  .product-buy .btn-primary:hover { background: #fff; border-color: #fff; color: #101720; }
  .product-buy .btn:not(.btn-primary) { min-width: 100%; }
  .product-price { color: #f1f4f7; font: 650 1.07rem/1.3 var(--font-body); font-variant-numeric: tabular-nums; letter-spacing: -.025em; }
  .upcoming-head { margin-top: clamp(2.6rem, 4.5vw, 4rem); padding-top: 1.4rem; border-top: 1px solid #ffffff20; display: flex; flex-direction: column; gap: .55rem; margin-bottom: 1.2rem; scroll-margin-top: 7rem; }
  .upcoming-head .section-index { color: #93a6b7; font-size: .6rem; letter-spacing: .13em; }
  .upcoming-title { font: 650 clamp(1.6rem, 3vw, 2.5rem)/1.07 var(--font-display); letter-spacing: -.035em; color: #edf2f6; }
  .upcoming-title .serif-accent { font-family: var(--font-display); font-style: normal; font-weight: 450; letter-spacing: -.025em; color: #aabaca; }
  .upcoming-sub { color: #b2bdc9; font-size: .85rem; max-width: 60ch; line-height: 1.6; }
  @keyframes object-orbit { 0%, 100% { transform: perspective(500px) rotateY(-24deg) rotateX(9deg) rotateZ(-10deg); } 50% { transform: perspective(500px) rotateY(24deg) rotateX(-6deg) rotateZ(10deg); } }
  @media (max-width: 760px) {
    .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; }
    .store-intro { gap: 1.2rem; }
    .product-info { padding: .95rem; }
    .product-buy { align-items: stretch; }
    .product-buy .btn { width: 100%; }
  }
  @media (max-width: 600px) {
    .store-intro { grid-template-columns: 1fr; gap: .9rem; margin-bottom: 1.15rem; }
    .store-logo { width: min(68%, 17rem); }
    .store-intro-copy > p { max-width: 38ch; font-size: .85rem; }
    .store-intro-copy > button { margin-top: .75rem; min-height: 44px; font-size: .71rem; }
    .collection-tabs { gap: .35rem; margin-bottom: 1.2rem; padding-bottom: .6rem; }
    .collection-tabs a { flex: 1; min-width: 0; gap: 0; padding-inline: .35rem; font-size: .72rem; }
    .collection-tabs a svg { display: none; }
    .collection-lead { margin-bottom: .8rem; }
    .product-grid { gap: .65rem; }
    .product-card { border-radius: 8px; }
    .product-stage { aspect-ratio: 1.06; }
    .stage-view { padding: 1.5rem .7rem 1.3rem; }
    .product-badge { top: .5rem; right: .5rem; padding: .27rem .4rem; font-size: .54rem; }
    .product-stage--photo { aspect-ratio: 1.02; }
    .product-stage--photo .stage-view { padding: 1.75rem .4rem .45rem; }
    .product-stage--tall { aspect-ratio: .82; }
    .product-info { padding: .75rem; }
    .product-info h3 { font-size: .91rem; line-height: 1.3; }
    .product-info p { margin: .45rem 0 .8rem; font-size: .76rem; line-height: 1.5; }
    .product-price { font-size: .91rem; }
    .product-buy { gap: .55rem; }
    .product-buy .btn { min-height: 44px; padding-inline: .4rem; font-size: .71rem; }
    .upcoming-head { margin-top: 2.6rem; padding-top: 1.1rem; gap: .5rem; }
    .upcoming-sub { font-size: .82rem; }
    .zoom-cue { right: .5rem; bottom: .5rem; }
  }
  @media (max-width: 359px) {
    .product-grid { grid-template-columns: minmax(0, 1fr); }
    .product-stage { aspect-ratio: 1.2; }
    .product-stage--photo { aspect-ratio: 1.18; }
    .product-stage--tall { aspect-ratio: .95; }
    .product-info { padding: 1rem; }
    .product-info h3 { font-size: 1.05rem; }
    .product-info p { font-size: .82rem; }
  }
  @media (prefers-reduced-motion: reduce) { .product-card, .collection-tabs a { transition: none; } .chamber-orbit { animation: none; } }
</style>
