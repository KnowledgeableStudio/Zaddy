---
import { Image } from 'astro:assets';
import heroBg from '../assets/hero-bg.png';
import Platforms from './Platforms.astro';
import { ARTIST } from '../data/site.js';
---

<section id="top" class="hero" aria-label="Introduction">
  <div class="hero-media" aria-hidden="true">
    <Image
      src={heroBg}
      alt=""
      class="hero-img"
      widths={[768, 1200, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-shade"></div>
    <div class="hero-vignette"></div>
  </div>

  <div class="hero-content container">
    <p class="eyebrow reveal">Official Artist · {ARTIST.location}</p>

    <h1 class="display hero-title reveal" data-delay="1">
      iZad<br />Casanova
    </h1>

    <p class="hero-tagline reveal" data-delay="2">
      <span class="serif-accent">{ARTIST.tagline}</span>
    </p>

    <div class="hero-ctas reveal" data-delay="3">
      <a href="#music" class="btn btn-primary btn-hud">Listen Now</a>
      <a href="#store" class="btn btn-hud">Shop Zaddy Collection</a>
    </div>

    <div class="hero-platforms reveal" data-delay="3">
      <Platforms limit={6} />
    </div>
  </div>

  <a href="#music" class="scroll-cue" aria-label="Scroll to latest releases">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 4v14m0 0l-6-6m6 6l6-6" />
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    animation: hero-drift 30s ease-in-out infinite alternate;
  }

  @keyframes hero-drift {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.07) translateY(-1.5%);
    }
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--bg) 4%,
      rgba(10, 10, 12, 0.55) 34%,
      rgba(10, 10, 12, 0.25) 60%,
      rgba(10, 10, 12, 0.45) 100%
    );
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 50% 40%, transparent 40%, rgba(0, 0, 0, 0.55) 100%);
  }

  .hero-content {
    position: relative;
    padding-top: 7rem;
    padding-bottom: clamp(3.5rem, 8vh, 6rem);
    width: 100%;
  }

  .hero-title {
    font-size: clamp(3rem, 10.5vw, 8.5rem);
    margin-top: 1.2rem;
    color: var(--text);
    text-shadow: 0 8px 60px rgba(0, 0, 0, 0.6);
  }

  .hero-tagline {
    margin-top: 0.9rem;
    font-size: clamp(1.2rem, 2.4vw, 1.75rem);
    color: var(--accent);
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.6);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.9rem;
  }

  .hero-platforms {
    margin-top: 2.1rem;
    max-width: 38rem;
  }

  .scroll-cue {
    position: absolute;
    bottom: 2rem;
    right: var(--gutter);
    display: none;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--muted);
    transition: color 0.2s ease, border-color 0.2s ease;
    animation: cue-bob 2.4s ease-in-out infinite;
  }

  .scroll-cue:hover {
    color: var(--text);
    border-color: var(--text);
  }

  @keyframes cue-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }

  @media (min-width: 860px) {
    .scroll-cue {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-img,
    .scroll-cue {
      animation: none;
    }
  }
</style>
