---
import Platforms from './Platforms.astro';
import { ARTIST } from '../data/site.js';
---

<section id="top" class="hero" aria-label="Introduction">
  <div class="hero-media" aria-hidden="true">
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
      src="/hero-loop.mp4"
    ></video>
    <div class="hero-letterbox"></div>
    <div class="hero-aurora"></div>
    <div class="hero-grain"></div>
    <div class="hero-shade"></div>
    <div class="hero-vignette"></div>
  </div>

  <div class="hero-content container">
    <p class="eyebrow reveal">Official Artist · {ARTIST.location}</p>

    <h1 class="display hero-title reveal" data-delay="1">
      iZad<br />Casanova
    </h1>

    <p class="hero-tagline reveal" data-delay="2">
      <span class="serif-accent">{ARTIST.tagline}</span>
    </p>

    <div class="hero-ctas reveal" data-delay="3">
      <a href="#music" class="btn btn-primary btn-hud">Listen Now</a>
      <a href="#store" class="btn btn-hud">Shop Zaddy Collection</a>
    </div>

    <div class="hero-platforms reveal" data-delay="3">
      <Platforms limit={6} />
    </div>
  </div>

  <audio id="bg-music" src="/audio/si-muero.mp3" loop preload="none"></audio>

  <button
    type="button"
    id="music-toggle"
    class="music-toggle"
    aria-label="Unmute background music"
    aria-pressed="false"
  >
    <svg class="mt-icon mt-off" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M11 5L6 9H2v6h4l5 4V5z" />
      <path d="M22 9l-6 6M16 9l6 6" />
    </svg>
    <svg class="mt-icon mt-on" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M11 5L6 9H2v6h4l5 4V5z" />
      <path d="M15.5 8.5a5 5 0 010 7" />
      <path d="M19 5a9 9 0 010 14" />
    </svg>
    <span class="mt-eq" aria-hidden="true"><i></i><i></i><i></i></span>
  </button>

  <a href="#music" class="scroll-cue" aria-label="Scroll to latest releases">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 4v14m0 0l-6-6m6 6l6-6" />
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    /* height follows the video's real aspect ratio (set by JS below):
       wide screens -> full-viewport band, narrow screens -> cinematic
       strip. The frame is always fully visible, never letterboxed. */
    height: clamp(48svh, calc(100vw / var(--video-ar, 2.2)), 100svh);
    min-height: 48svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* cinematic loop is THE background — cover fills the whole hero,
     no letterbox gaps on any screen */
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* cinema letterbox — hard black bars top & bottom, movie framing */
  .hero-letterbox {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      #000 0 7%,
      transparent 7% 93%,
      #000 93% 100%
    );
  }

  /* drifting aurora light pools — slow green glows wandering the
     letterbox zones so the frame never feels empty */
  .hero-aurora {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(38% 30% at 22% 12%, rgba(34, 216, 97, 0.16), transparent 70%),
      radial-gradient(34% 26% at 80% 88%, rgba(34, 216, 97, 0.12), transparent 70%),
      radial-gradient(46% 34% at 68% 6%, rgba(120, 200, 255, 0.07), transparent 70%);
    animation: aurora-drift 26s ease-in-out infinite alternate;
  }

  @keyframes aurora-drift {
    from {
      transform: translate3d(-2.5%, 1.5%, 0) scale(1);
    }
    to {
      transform: translate3d(2.5%, -1.5%, 0) scale(1.08);
    }
  }

  /* faint scanlines + grain unify the video with the hologram look */
  .hero-grain {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        0deg,
        rgba(34, 216, 97, 0.025) 0 1px,
        transparent 1px 5px
      );
    mix-blend-mode: screen;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--bg) 4%,
      rgba(10, 10, 12, 0.55) 34%,
      rgba(10, 10, 12, 0.25) 60%,
      rgba(10, 10, 12, 0.45) 100%
    );
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 50% 40%, transparent 40%, rgba(0, 0, 0, 0.55) 100%);
  }

  .hero-content {
    position: relative;
    padding-top: 3.4rem;
    padding-bottom: clamp(1.7rem, 3.8vh, 2.9rem);
    width: 100%;
  }

  .hero-content .eyebrow {
    font-size: 0.55rem;
  }

  .hero-title {
    font-size: clamp(1.5rem, 5vw, 4.1rem);
    margin-top: 0.55rem;
    color: var(--text);
    text-shadow: 0 8px 60px rgba(0, 0, 0, 0.6);
  }

  .hero-tagline {
    margin-top: 0.45rem;
    font-size: clamp(0.68rem, 1.2vw, 0.85rem);
    color: var(--accent);
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.6);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.36rem;
    margin-top: 0.9rem;
  }

  .hero-ctas .btn {
    padding: 0.34rem 0.68rem;
    font-size: 0.56rem;
    gap: 0.3rem;
  }

  .hero-platforms {
    margin-top: 1.05rem;
    max-width: 19rem;
  }

  .hero-platforms :global(.platforms) {
    gap: 0.28rem;
  }

  .hero-platforms :global(.platform-chip) {
    padding: 0.28rem 0.52rem;
    font-size: 0.56rem;
    gap: 0.25rem;
  }

  .hero-platforms :global(.platform-chip svg) {
    width: 9px;
    height: 9px;
  }

  /* background-music control — bottom-right of the frame, sits over
     the letterbox bar. Same glass-pill language as the scroll cue. */
  .music-toggle {
    position: absolute;
    bottom: 1.1rem;
    right: var(--gutter);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: rgba(10, 10, 12, 0.55);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--muted);
    transition:
      color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .music-toggle:hover {
    color: var(--text);
    border-color: rgba(255, 255, 255, 0.32);
  }

  /* playing + audible: green ring + animated EQ bars */
  .music-toggle.is-on {
    color: var(--accent);
    border-color: rgba(34, 216, 97, 0.55);
    box-shadow:
      0 0 0 1px rgba(34, 216, 97, 0.18),
      0 0 22px rgba(34, 216, 97, 0.22);
  }

  .mt-icon {
    flex-shrink: 0;
  }

  .music-toggle .mt-on,
  .music-toggle.is-on .mt-off {
    display: none;
  }

  .music-toggle.is-on .mt-on {
    display: block;
  }

  .mt-eq {
    display: none;
    align-items: flex-end;
    gap: 1.5px;
    height: 10px;
  }

  .music-toggle.is-on .mt-eq {
    display: inline-flex;
  }

  .mt-eq i {
    width: 2px;
    background: var(--accent);
    border-radius: 1px;
    animation: eq-bounce 0.9s ease-in-out infinite;
  }

  .mt-eq i:nth-child(1) { height: 60%; }
  .mt-eq i:nth-child(2) { height: 100%; animation-delay: 0.18s; }
  .mt-eq i:nth-child(3) { height: 45%; animation-delay: 0.36s; }

  @keyframes eq-bounce {
    0%, 100% { transform: scaleY(0.4); }
    50% { transform: scaleY(1); }
  }

  .scroll-cue {
    position: absolute;
    bottom: 2rem;
    right: calc(var(--gutter) + 3.75rem);
    display: none;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--muted);
    transition: color 0.2s ease, border-color 0.2s ease;
    animation: cue-bob 2.4s ease-in-out infinite;
  }

  .scroll-cue:hover {
    color: var(--text);
    border-color: var(--text);
  }

  @keyframes cue-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }

  @media (min-width: 860px) {
    .scroll-cue {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue {
      animation: none;
    }

    .hero-video {
      display: none;
    }

    .hero-aurora {
      animation: none;
    }

    .mt-eq i {
      animation: none;
      transform: scaleY(0.8);
    }
  }
</style>

<script>
  // reduced-motion users get a still frame instead of the video loop
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.hero-video').forEach((v) => v.pause());
  }

  // size the hero to the video's true aspect ratio — the whole frame
  // displays edge-to-edge on every device, no letterbox, no gaps
  const hero = document.querySelector('.hero');
  const vid = document.querySelector('.hero-video');
  function syncHeroRatio() {
    if (vid && vid.videoWidth) {
      hero.style.setProperty('--video-ar', (vid.videoWidth / vid.videoHeight).toFixed(4));
    }
  }
  if (vid) {
    if (vid.readyState >= 1) syncHeroRatio();
    vid.addEventListener('loadedmetadata', syncHeroRatio);
  }
</script>
