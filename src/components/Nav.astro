---
import { Image } from 'astro:assets';
import zaddyWordmark from '../assets/zaddy-wordmark.png';
---

<header id="site-nav">
  <div class="nav-inner container">
    <a href="/#top" class="brand" aria-label="Zaddy Collection — iZad Casanova, back to top">
      <Image
        src={zaddyWordmark}
        alt="Zaddy Collection"
        class="brand-logo"
        widths={[240, 400]}
        height={40}
        loading="eager"
        decoding="async"
      />
    </a>

    <nav class="nav-links" aria-label="Primary">
      <a href="/#music">Music</a>
      <a href="/story">Story</a>
      <a href="/#store">Store</a>
      <a href="/#contact">Contact</a>
    </nav>

    <div class="nav-actions">
      <div id="nav-experience" class="nav-experience" aria-label="Experience controls"></div>
      <button class="btn btn-sm cart-open" id="cart-open" type="button" aria-label="Open cart">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 8h14l1 13H4L5 8Z" />
          <path d="M8 8V6a4 4 0 0 1 8 0v2" />
        </svg>
        <span class="cart-label">Cart</span>
        <span id="cart-count" class="cart-count" aria-hidden="true">0</span>
      </button>

      <button class="btn btn-sm btn-icon" id="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label="Mobile">
      <a href="/#music">Music</a>
      <a href="/story">Story</a>
      <a href="/#store">Store</a>
      <a href="/#contact">Contact</a>
    </nav>
    <div id="mobile-experience" class="mobile-experience" aria-label="Experience controls"></div>
  </div>
</header>

<style>
  #site-nav { position: fixed; top: 18px; left: 50%; width: min(calc(100% - 40px), 1380px); transform: translateX(-50%); z-index: 100; border: 1px solid #d5e3f02b; border-radius: 11px; background: linear-gradient(160deg, #222b36cc, #11161ecc 42%, #090e15e8); box-shadow: inset 0 1px 0 #ffffff0b, 0 12px 40px #0004; backdrop-filter: blur(24px) saturate(.6); transition: background .3s, border-color .3s, box-shadow .3s; }
  #site-nav::before { content: ''; position: absolute; left: 10%; right: 10%; top: -1px; height: 1px; background: linear-gradient(90deg, transparent, #f1f6ff7a, transparent); pointer-events: none; }
  #site-nav.scrolled { background: linear-gradient(135deg, #1b232ded, #0b1017f2); border-color: #d5e3f034; box-shadow: inset 0 1px 0 #ffffff08, 0 14px 36px #0006; }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; min-height: 76px; padding-inline: clamp(1.1rem, 2.3vw, 2.2rem); transition: min-height .3s var(--ease-out); }
  #site-nav.scrolled .nav-inner { min-height: 68px; }
  .brand { display: flex; align-items: center; min-height: 48px; flex-shrink: 0; position: relative; }
  .brand-logo { width: auto; height: 35px; max-width: 200px; object-fit: contain; filter: drop-shadow(0 3px 8px #0008); }
  .nav-links { display: flex; align-items: center; gap: .4rem; }
  .nav-links a { position: relative; display: flex; align-items: center; justify-content: center; min-height: 44px; padding: .65rem clamp(.8rem, 1.6vw, 1.4rem); font: 500 .71rem var(--font-body); letter-spacing: .12em; text-transform: uppercase; color: #b6c0cc; transition: color .2s; }
  .nav-links a::after { content: ''; position: absolute; bottom: 3px; left: 35%; right: 35%; height: 1px; background: #e7eef5; transform: scaleX(0); transform-origin: center; transition: transform .3s var(--ease-out); }
  .nav-links a:hover, .nav-links a.active { color: #fff; }
  .nav-links a:hover::after, .nav-links a.active::after { transform: scaleX(1); }
  .nav-actions { display: flex; align-items: center; gap: .6rem; }
  #nav-experience { display: flex; align-items: center; gap: .5rem; }
  #nav-experience :global(.motion-toggle), #nav-experience :global(.music-toggle),
  #mobile-experience :global(.motion-toggle), #mobile-experience :global(.music-toggle) { position: static; inset: auto; min-width: 44px; min-height: 44px; height: 44px; border-radius: 6px; border-color: #d7e6f124; background: #ffffff04; box-shadow: inset 0 1px 0 #ffffff04; backdrop-filter: none; }
  #nav-experience :global(.motion-toggle), #nav-experience :global(.music-toggle) { width: 44px; padding: 0; justify-content: center; }
  #nav-experience :global(.motion-label), #nav-experience :global(.mt-on), #nav-experience :global(.mt-off) { display: none; }
  #mobile-experience { display: flex; align-items: stretch; gap: .65rem; padding-top: .8rem; margin-top: .25rem; border-top: 1px solid #d6e5f11c; }
  #mobile-experience :global(.motion-toggle), #mobile-experience :global(.music-toggle) { flex: 1; width: auto; padding: .65rem .8rem; justify-content: center; gap: .65rem; font-size: .63rem; }
  #mobile-experience :global(.motion-label), #mobile-experience :global(.music-toggle .mt-off), #mobile-experience :global(.music-toggle.is-on .mt-on) { display: inline; }
  #mobile-experience :global(.music-toggle .mt-on), #mobile-experience :global(.music-toggle.is-on .mt-off) { display: none; }
  .cart-open { min-height: 44px; background: #ffffff05; border-color: #d7e6f124; gap: .65rem; padding-inline: .9rem; box-shadow: inset 0 1px 0 #ffffff06; }
  .cart-open:hover { background: #ffffff0d; }
  .cart-open svg { width: 18px; height: 18px; color: #e2eaf3; }
  .cart-label { font: 500 .74rem var(--font-body); letter-spacing: .025em; }
  .cart-count { display: grid; place-items: center; min-width: 1.2rem; height: 1.2rem; padding-inline: .25rem; background: #dce4ee; color: #11161e; border-radius: 50%; font: 600 .61rem var(--font-body); font-variant-numeric: tabular-nums; }
  #menu-toggle { display: none; min-width: 44px; width: 44px; min-height: 44px; height: 44px; background: #ffffff04; border-color: #d7e6f124; }
  .scroll-progress { position: absolute; left: 10px; right: 10px; bottom: -1px; height: 1px; background: linear-gradient(90deg, #a8bfd5, #f2f6fb); transform-origin: left; transform: scaleX(0); }
  .mobile-menu { position: absolute; top: calc(100% + 8px); inset-inline: 0; border: 1px solid #d5e3f02b; border-radius: 10px; background: linear-gradient(135deg, #1d2631fc, #0c1119fc); box-shadow: inset 0 1px 0 #ffffff08, 0 24px 50px #0007; padding: .6rem 1.25rem 1rem; animation: menu-in .3s var(--ease-out) both; }
  .mobile-menu nav { display: flex; flex-direction: column; }
  .mobile-menu a { display: flex; align-items: center; min-height: 64px; border-bottom: 1px solid #d6e5f117; font: 600 1.6rem/1 var(--font-display); letter-spacing: -.035em; color: #e9eef4; }
  .mobile-menu a::after { content: '↗'; margin-left: auto; font-size: 1.3rem; font-weight: 400; color: #9bafc4; }
  .mobile-menu a:last-child { border-bottom: 0; }
  .mobile-menu a:hover { color: #fff; }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
  @media (max-width: 1100px) { .nav-inner { gap: 1rem; } .nav-links a { padding-inline: .75rem; } }
  @media (max-width: 859px) {
    #site-nav { top: 12px; width: calc(100% - 24px); border-radius: 9px; }
    .nav-inner, #site-nav.scrolled .nav-inner { min-height: 64px; gap: .75rem; padding-inline: .8rem; }
    .mobile-menu { max-height: calc(100vh - 98px); max-height: calc(100dvh - 98px); overflow-y: auto; overscroll-behavior-y: contain; }
    .brand-logo { height: 29px; max-width: 158px; }
    .nav-links { display: none; }
    #nav-experience { display: none; }
    #menu-toggle { display: inline-flex; }
    .cart-label { display: none; }
    .cart-open { min-height: 44px; min-width: 44px; padding-inline: .65rem; gap: .5rem; }
  }
  @media (max-width: 370px) { .brand-logo { max-width: 135px; height: 27px; } .nav-actions { gap: .35rem; } }
  @media (max-width: 859px) and (max-height: 500px) { .mobile-menu a { min-height: 48px; font-size: 1.2rem; } #mobile-experience { padding-top: .55rem; margin-top: 0; } }
  @media (prefers-reduced-motion: reduce) { #site-nav, .nav-inner, .nav-links a::after { transition: none; } .mobile-menu { animation: none; } }
</style>
