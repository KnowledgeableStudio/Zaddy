---
import { getImage, Image } from 'astro:assets';
import llenoArt from '../assets/lleno-de-balas.webp';
import todaviaArt from '../assets/todavia-artwork.jpeg';
import { RELEASES } from '../data/site.js';
import { siApplemusic, siSpotify } from 'simple-icons';

const linkIcons = {
  'Apple Music': siApplemusic,
  Spotify: siSpotify,
} as const;

const artwork = {
  'lleno-de-balas': llenoArt,
  todavia: todaviaArt,
} as const;

// larger webp variants for the lightbox viewer
const viewerSrc = Object.fromEntries(
  await Promise.all(
    Object.entries(artwork).map(async ([key, img]) => [
      key,
      (await getImage({ src: img, width: 1200, format: 'webp' })).src,
    ])
  )
);
---

<section id="music" class="section" aria-labelledby="music-heading" data-motion-scene>
  <div class="container">
    <div class="section-head release-heading reveal">
      <span class="section-index">01 — Releases</span>
      <h2 id="music-heading">Latest <span class="serif-accent">Songs</span></h2>
      <p>New releases &amp; official videos — updated regularly.</p>
    </div>

    <div class="releases-grid" role="group" aria-label="Releases">
      {
        RELEASES.map((release, i) => (
          <article class="release-card reveal" data-depth data-motion-scene data-delay={String(i)} style={`--card-i:${i}`}>
            <div class="release-stamp" aria-hidden="true">iZad Casanova</div>
            <div class="release-art" data-depth-surface>
              <div class="record-disc" aria-hidden="true" data-ambient><span>iZad</span></div>
              <button
                class="stage-view"
                data-float
                type="button"
                data-viewer-group="releases"
                data-viewer-src={viewerSrc[release.artwork]}
                data-viewer-alt={`${release.title} cover art`}
                aria-label={`Enlarge ${release.title} cover art`}
              >
                <Image
                  src={artwork[release.artwork]}
                  alt=""
                  widths={[400, 640, 900]}
                  sizes="(max-width: 600px) 140px, 230px"
                  loading="lazy"
                />
              </button>
            </div>
            <div class="release-info">
              <h3>{release.title}</h3>
              <p class="release-meta">{release.meta}</p>
              <div class="release-links">
                {release.links.map((link) =>
                  link.primary && release.videoId ? (
                    <button
                      type="button"
                      class="btn btn-primary btn-sm"
                      data-video={release.videoId}
                      data-video-title={release.title}
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M8 5.5v13l11-6.5-11-6.5z" />
                      </svg>
                      Play Video
                    </button>
                  ) : (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class:list={['btn btn-sm', { 'btn-primary': link.primary }]}
                    >
                      {linkIcons[link.label] && (
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          aria-hidden="true"
                          set:html={`<path d="${linkIcons[link.label].path}"/>`}
                        />
                      )}
                      {link.label}
                    </a>
                  )
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

</section>

  <!-- Video lightbox — iframe injected on demand -->
  <div id="video-modal" class="video-modal" role="dialog" aria-modal="true" aria-label="Music video player" hidden>
    <div class="video-backdrop" data-video-close></div>
    <div class="video-shell">
      <div class="video-shell-head">
        <span id="video-title"></span>
        <button class="btn btn-icon" type="button" data-video-close aria-label="Close video">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="video-frame" id="video-frame"></div>
    </div>
  </div>

<style>
  .section { position: relative; padding-block: clamp(3.5rem, 6vw, 6rem); }
  .container { max-width: calc(72rem + var(--gutter) + var(--gutter)); }
  .release-heading { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: .85rem 2rem; margin-bottom: 1.8rem; }
  .release-heading .section-index { grid-column: 1 / -1; }
  .release-heading h2 { max-width: 14ch; font-size: clamp(2.3rem, 4.5vw, 4rem); }
  .release-heading h2 .serif-accent { color: #abbecd; font-family: var(--font-display); font-weight: 450; font-style: normal; text-transform: none; }
  .release-heading p { max-width: 28ch; padding-bottom: .3rem; font-size: .88rem; color: #adbcca; }
  .releases-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1.25rem; align-items: stretch; }
  .release-card { position: relative; display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1fr); grid-template-rows: auto 1fr; align-items: center; gap: 1rem 1.2rem; min-width: 0; min-height: 300px; padding: 1.3rem 1.4rem 1.5rem; border: 1px solid #d6e0ea2b; border-radius: 12px; background: linear-gradient(160deg, #1b242f, #111822 42%, #0b121b); box-shadow: inset 0 1px #ffffff1a, inset 0 -1px #000d, 0 5px 0 #020609c9, 0 24px 35px -23px #000e; overflow: hidden; isolation: isolate; transition: border-color .3s, box-shadow .3s; }
  .release-card::before { content: ''; position: absolute; z-index: 4; inset: 0; pointer-events: none; background: radial-gradient(ellipse at var(--light-x, 50%) var(--light-y, 30%), #e2edff12, transparent 47%); opacity: .35; transition: opacity .3s; }
  .release-card::after { content: ''; position: absolute; z-index: 5; bottom: 0; left: 1rem; right: 1rem; height: 1px; pointer-events: none; background: linear-gradient(90deg, transparent, #c9d8ee5c, transparent); }
  .release-card:hover, .release-card:focus-within { border-color: #d5e5f263; box-shadow: inset 0 1px #ffffff25, inset 0 -1px #000d, 0 5px 0 #020609c9, 0 28px 42px -24px #000f; }
  .release-card:hover::before, .release-card:focus-within::before { opacity: 1; }
  .release-stamp { grid-column: 1 / -1; color: #94a4b5; font: 600 .61rem/1.4 var(--font-body); letter-spacing: .12em; text-transform: uppercase; }
  .release-art { position: relative; grid-column: 1; display: flex; align-items: center; width: 100%; min-width: 0; aspect-ratio: 1; }
  .release-art::before { content: ''; position: absolute; left: 4%; right: 2%; bottom: 7%; height: 15%; border-radius: 50%; background: #0009; filter: blur(12px); }
  .record-disc { position: absolute; top: 9%; right: -3%; width: 83%; aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%; border: 1px solid #d7e3f23d; background: radial-gradient(circle, #070b10 0 3%, #b3c2d0 3.2% 4%, #682330 4.4% 19%, #1b2632 19.2% 22%, transparent 22.5%), repeating-radial-gradient(circle, #070b10 0 1.7px, #abb6c21c 1.9px 2.5px, #03060b 2.8px 3.5px), conic-gradient(from 35deg, #0b1018, #b3bac2, #111923, #606d7b, #0b1018); box-shadow: 8px 16px 22px #0008, inset 0 0 0 5px #0004; animation: record-turn 34s linear infinite; }
  .record-disc span { color: #e8d4d9; font: italic .8rem var(--font-serif); }
  .release-art .stage-view { position: relative; z-index: 2; display: grid; place-items: center; width: 85%; height: auto; aspect-ratio: 1; padding: 3px; border: 1px solid #dce8f755; border-radius: 3px; background: #141c26; box-shadow: 9px 15px 22px #000a, inset 0 1px #fff6; transform-origin: center; --float-duration: 8s; --float-delay: calc(var(--card-i) * -2s); }
  .release-art img { width: 100%; height: 100%; object-fit: contain; }
  .release-info { grid-column: 2; position: relative; z-index: 3; min-width: 0; align-self: center; }
  .release-info h3 { font: 650 clamp(1.18rem, 1.8vw, 1.7rem)/1.13 var(--font-display); letter-spacing: -.025em; color: #f1f4f7; }
  .release-meta { margin-top: .7rem; font: .65rem/1.5 var(--font-body); letter-spacing: .03em; color: #9dabb9; }
  .release-links { display: flex; flex-direction: column; align-items: stretch; gap: .55rem; margin-top: 1.1rem; }
  .release-links .btn { min-height: 44px; padding: .65rem .7rem; gap: .55rem; border: 1px solid #ffffff28; border-radius: 6px; clip-path: none; background: #1b2632; color: #e3ebf1; font-size: .74rem; font-weight: 600; letter-spacing: 0; box-shadow: none; }
  .release-links .btn-primary { background: #edf2f6; border-color: #edf2f6; color: #101822; }
  .release-links .btn:hover { background: #2c3a49; border-color: #bdd2e363; color: #fff; box-shadow: none; }
  .release-links .btn-primary:hover { background: #fff; border-color: #fff; color: #101822; }
  .video-modal { --video-padding: var(--gutter); position: fixed; inset: 0; z-index: 350; display: grid; place-items: center; padding: var(--video-padding); }
  .video-backdrop { position: absolute; inset: 0; background: #02050bef; backdrop-filter: blur(16px); }
  .video-shell { position: relative; display: flex; flex-direction: column; width: min(100%, 68rem); max-height: calc(100vh - 2 * var(--video-padding)); max-height: calc(100dvh - 2 * var(--video-padding)); border: 1px solid #d3e0ed38; border-radius: 10px; overflow: hidden; background: #111720; box-shadow: 0 40px 100px #000c; animation: screen-in .3s var(--ease-out); }
  .video-shell-head { display: flex; flex-shrink: 0; justify-content: space-between; align-items: center; min-height: 64px; padding: .5rem .7rem .5rem 1.3rem; border-bottom: 1px solid #ffffff1c; background: #141d27; gap: 1rem; font-size: .88rem; }
  .video-shell-head span { min-width: 0; overflow-wrap: anywhere; color: #eef3f7; font-family: var(--font-display); font-weight: 600; }
  .video-shell-head .btn { flex-shrink: 0; min-height: 44px; width: 44px; height: 44px; border: 1px solid #ffffff25; border-radius: 6px; clip-path: none; background: #1d2835; color: #e7edf3; box-shadow: none; }
  .video-frame { position: relative; flex-shrink: 1; min-height: 0; aspect-ratio: 16 / 9; background: #000; }
  .video-frame :global(iframe) { position: absolute; inset: 0; display: block; width: 100%; height: 100%; border: 0; }
  @keyframes record-turn { to { transform: rotate(360deg); } }
  @keyframes screen-in { from { opacity: 0; transform: perspective(1200px) translateY(16px) rotateX(2deg) scale(.98); } to { opacity: 1; transform: none; } }
  @media (max-width: 1050px) and (min-width: 821px) {
    .release-card { padding: 1.2rem 1.1rem; gap: .9rem; grid-template-columns: minmax(0, .9fr) minmax(0, 1fr); }
    .release-info h3 { font-size: 1.2rem; }
  }
  @media (max-width: 820px) {
    .releases-grid { grid-template-columns: minmax(0, 1fr); max-width: 35rem; margin-inline: auto; gap: 1.1rem; }
    .release-card { min-height: 275px; }
    .release-info h3 { font-size: 1.5rem; }
  }
  @media (max-width: 600px) {
    .release-heading { grid-template-columns: 1fr; gap: .8rem; margin-bottom: 1.3rem; }
    .release-heading p { max-width: 38ch; font-size: .84rem; }
    .release-card { grid-template-columns: minmax(0, .95fr) minmax(0, 1fr); min-height: 252px; padding: .9rem 1rem 1.1rem; gap: .75rem .9rem; border-radius: 10px; }
    .release-stamp { font-size: .57rem; }
    .release-art .stage-view { width: 89%; }
    .release-info h3 { font-size: clamp(1.06rem, 4.5vw, 1.35rem); line-height: 1.16; }
    .release-meta { margin-top: .5rem; font-size: .6rem; }
    .release-links { margin-top: .8rem; gap: .45rem; }
    .release-links .btn { padding-inline: .4rem; gap: .4rem; font-size: .69rem; min-height: 44px; }
    .release-links .btn svg { width: 13px; height: 13px; }
    .video-modal { --video-padding: .75rem; }
    .video-shell-head { font-size: .8rem; padding-left: 1rem; }
  }
  @media (max-width: 359px) { .release-card { padding-inline: .8rem; gap: .7rem; } .release-info h3 { font-size: 1rem; } }
  @media (prefers-reduced-motion: reduce) { .video-shell, .record-disc { animation: none; } .release-card { transition: none; } }
</style>
