---
import { getImage, Image } from 'astro:assets';
import zaddyWordmark from '../assets/zaddy-wordmark.png';
import maskSignature from '../assets/mask-signature.png';
import maskUrban from '../assets/mask-urban.png';
import maskElite from '../assets/mask-elite.png';

const [sig, urb, eli] = await Promise.all(
  [maskSignature, maskUrban, maskElite].map((img) =>
    getImage({ src: img, width: 104, height: 104, format: 'webp' })
  )
);

const thumbs = {
  'signature-mask': sig.src,
  'urban-mask': urb.src,
  'elite-mask': eli.src,
};
---

<div id="cart-backdrop" class="cart-backdrop" hidden></div>

<aside
  id="cart-drawer"
  class="cart-drawer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cart-title"
  hidden
>
  <header class="drawer-head">
    <div class="drawer-brand">
      <Image
        src={zaddyWordmark}
        alt="Zaddy Collection"
        width={140}
        height={44}
        format="webp"
        loading="eager"
        class="drawer-logo"
      />
      <h2 id="cart-title">Your Cart</h2>
    </div>
    <button class="btn btn-icon" id="cart-close" type="button" aria-label="Close cart">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </header>

  <!-- Cart view -->
  <div id="cart-view" class="drawer-body">
    <div id="cart-items" class="cart-items"></div>
    <p id="cart-empty" class="cart-empty">Your cart is empty.</p>
  </div>

  <!-- Checkout view -->
  <div id="checkout-view" class="drawer-body" hidden>
    <div class="checkout-summary">
      <h3 class="summary-title">Order summary</h3>
      <div id="checkout-items" class="checkout-items"></div>
      <div class="totals">
        <div><span>Subtotal</span><span id="checkout-subtotal">$0.00</span></div>
        <div><span>Shipping</span><span id="checkout-shipping" class="js-shipping">$5.00</span></div>
        <div class="total-row"><span>Total</span><span id="checkout-total">$5.00</span></div>
      </div>
    </div>

    <form id="checkout-form" novalidate>
      <div class="field">
        <label for="co-name">Full name</label>
        <input id="co-name" aria-describedby="err-name" name="name" type="text" autocomplete="name" maxlength="128" placeholder="Jane Doe…" required />
        <span class="error" id="err-name">Enter your full name.</span>
      </div>
      <div class="field">
        <label for="co-email">Email</label>
        <input id="co-email" aria-describedby="err-email" name="email" type="email" autocomplete="email" spellcheck="false" maxlength="254" placeholder="jane@example.com…" required />
        <span class="error" id="err-email">Enter a valid email address.</span>
      </div>
      <div class="field">
        <label for="co-address">Street address</label>
        <input id="co-address" aria-describedby="err-address" name="address" type="text" autocomplete="street-address" maxlength="200" placeholder="123 Main St…" required />
        <span class="error" id="err-address">Enter your street address.</span>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="co-city">City</label>
          <input id="co-city" aria-describedby="err-city" name="city" type="text" autocomplete="address-level2" maxlength="100" placeholder="New York…" required />
          <span class="error" id="err-city">Enter your city.</span>
        </div>
        <div class="field">
          <label for="co-state">State</label>
          <input id="co-state" aria-describedby="err-state" name="state" type="text" autocomplete="address-level1" maxlength="100" placeholder="NY…" required />
          <span class="error" id="err-state">Enter your state.</span>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="co-zip">ZIP code</label>
          <input id="co-zip" aria-describedby="err-zip" name="zip" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="20" placeholder="10001…" required />
          <span class="error" id="err-zip">Enter your ZIP code.</span>
        </div>
        <div class="field">
          <label for="co-country">Country</label>
          <select id="co-country" name="country" autocomplete="country" required>
            <option value="US" selected>United States</option>
            <option value="CA">Canada</option>
            <option value="GB">United Kingdom</option>
            <option value="AU">Australia</option>
          </select>
        </div>
      </div>
    </form>

    <div class="payment-block">
      <div class="payment-head">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <h3>Payment</h3>
      </div>
      <div id="paypal-button-container"></div>
      <p class="payment-note">Secure SSL · PayPal Buyer Protection</p>
    </div>
  </div>

  <footer class="drawer-foot">
    <div id="cart-foot" class="drawer-foot-inner">
      <div class="totals">
        <div><span>Subtotal</span><span id="cart-subtotal">$0.00</span></div>
        <div><span>Shipping</span><span class="js-shipping">$5.00</span></div>
        <div class="total-row"><span>Total</span><span id="cart-total">$5.00</span></div>
      </div>
      <div class="drawer-actions">
        <button class="btn btn-sm" id="cart-clear" type="button">Clear</button>
        <button class="btn btn-primary" id="to-checkout" type="button">Checkout</button>
      </div>
    </div>
    <div id="checkout-foot" class="drawer-foot-inner" hidden>
      <button class="btn" id="back-to-cart" type="button">Back to Cart</button>
      <button class="btn" id="cart-clear-2" type="button">Clear Cart</button>
    </div>
  </footer>
</aside>

<div id="toast-region" aria-live="polite" aria-atomic="false"></div>

<script is:inline id="product-thumbs" type="application/json" set:html={JSON.stringify(thumbs).replace(/</g, '\\u003c')} />

<style is:global>
  #cart-backdrop { position: fixed; inset: 0; z-index: 110; background: #020408b8; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); opacity: 0; transition: opacity .3s ease; }
  #cart-backdrop.show { opacity: 1; }
  #cart-drawer { position: fixed; inset: 0 0 0 auto; z-index: 111; width: min(30rem, 100vw); height: 100dvh; display: flex; flex-direction: column; color: #f1f4f7; background: #10161f; border-left: 1px solid #d7e3ef2b; box-shadow: -24px 0 70px #0008; transform: translateX(100%); transition: transform .35s var(--ease-out); overscroll-behavior: contain; }
  #cart-drawer[hidden], #cart-backdrop[hidden], #cart-drawer [hidden] { display: none !important; }
  #cart-drawer.show { transform: translateX(0); }
  #cart-drawer .drawer-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-shrink: 0; padding: 1.45rem 1.5rem 1.3rem; border-bottom: 1px solid #ffffff1c; background: #10161f; }
  #cart-drawer .drawer-brand { display: flex; flex-direction: column; gap: .8rem; }
  #cart-drawer .drawer-logo { width: 7.5rem; height: auto; }
  #cart-drawer .drawer-head h2 { font: 650 1.55rem/1.1 var(--font-display); letter-spacing: -.025em; color: #f1f4f7; text-transform: none; }
  #cart-drawer button { min-height: 44px; }
  #cart-drawer .btn { min-height: 48px; padding: .75rem 1rem; border: 1px solid #ffffff2c; border-radius: 6px; clip-path: none; background: #1c2733; color: #edf2f6; font-size: .83rem; font-weight: 600; line-height: 1.3; letter-spacing: 0; text-transform: none; box-shadow: none; transform: none; }
  #cart-drawer .btn:hover { border-color: #cad7e651; background: #2b3847; box-shadow: none; transform: none; }
  #cart-drawer .btn-primary { border-color: #eef2f6; background: #eef2f6; color: #111720; }
  #cart-drawer .btn-primary:hover { border-color: #fff; background: #fff; color: #111720; }
  #cart-drawer .btn-icon { display: grid; place-items: center; width: 44px; min-width: 44px; height: 44px; min-height: 44px; padding: 0; border-color: transparent; border-radius: 6px; background: transparent; color: #c5cfd9; }
  #cart-drawer .btn-icon:hover { background: #202b38; border-color: transparent; }
  #cart-drawer button:focus-visible, #cart-drawer input:focus-visible, #cart-drawer select:focus-visible { outline: 2px solid #b7d4e5; outline-offset: 3px; }
  #cart-drawer .drawer-body { flex: 1; min-height: 0; overflow-y: auto; overflow-x: hidden; padding: 1.4rem 1.5rem; display: flex; flex-direction: column; gap: 1.4rem; scrollbar-width: thin; scrollbar-color: #435268 #10161f; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; }
  #cart-drawer .cart-items { display: flex; flex-direction: column; gap: 0; }
  #cart-drawer .cart-item { display: grid; grid-template-columns: 80px minmax(0, 1fr) 44px; align-items: center; column-gap: .9rem; row-gap: .65rem; padding: 1.1rem 0 1.4rem; border-bottom: 1px solid #ffffff1a; }
  #cart-drawer .cart-item:first-child { padding-top: 0; }
  #cart-drawer .cart-item > img { grid-column: 1; grid-row: 1 / 3; width: 80px; height: 96px; padding: .3rem; object-fit: contain; border: 1px solid #ffffff12; border-radius: 6px; background: #1b2531; }
  #cart-drawer .item-info { grid-column: 2; min-width: 0; }
  #cart-drawer .item-name { font-weight: 600; font-size: .92rem; line-height: 1.35; color: #f1f4f7; }
  #cart-drawer .item-price { margin-top: .35rem; color: #bac5d1; font-size: .86rem; font-variant-numeric: tabular-nums; }
  #cart-drawer .qty { grid-column: 2; display: inline-flex; align-items: center; justify-self: start; border: 1px solid #6e7e914d; border-radius: 5px; background: #121b26; overflow: hidden; }
  #cart-drawer .qty button { display: grid; place-items: center; width: 44px; height: 44px; min-height: 44px; padding: 0; color: #dfe7ef; font-size: 1.1rem; border-radius: 0; background: transparent; transition: background .2s ease; }
  #cart-drawer .qty button:hover { background: #263545; }
  #cart-drawer .qty span { min-width: 2rem; text-align: center; font-size: .86rem; font-variant-numeric: tabular-nums; }
  #cart-drawer .item-remove { grid-column: 3; grid-row: 1; display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 6px; background: transparent; color: #aebbc9; }
  #cart-drawer .item-remove:hover { color: #f2d3d6; background: #39252d; }
  #cart-drawer .cart-empty { color: #b9c5d1; text-align: center; margin-block: auto; padding: 3rem 1rem; font-size: 1.05rem; }
  #cart-drawer .drawer-foot { flex-shrink: 0; border-top: 1px solid #ffffff22; background: #131c27; padding: 1.25rem 1.5rem max(1.25rem, env(safe-area-inset-bottom)); }
  #cart-drawer .drawer-foot-inner { display: flex; flex-direction: column; gap: 1.2rem; }
  #cart-drawer .totals { display: flex; flex-direction: column; gap: .6rem; }
  #cart-drawer .totals > div { display: flex; justify-content: space-between; gap: 1rem; font-size: .85rem; color: #b6c2ce; }
  #cart-drawer .totals .total-row { font-family: var(--font-display); font-size: 1.25rem; font-weight: 650; color: #f1f4f7; padding-top: .85rem; margin-top: .2rem; border-top: 1px solid #ffffff1c; font-variant-numeric: tabular-nums; }
  #cart-drawer .drawer-actions { display: flex; gap: .75rem; }
  #cart-drawer #cart-clear { min-width: 80px; }
  #cart-drawer #to-checkout { flex: 1; }
  #cart-drawer #checkout-foot { flex-direction: row; flex-wrap: wrap; justify-content: space-between; gap: .7rem; }
  #cart-drawer #checkout-foot .btn { flex: 1; }
  #cart-drawer .checkout-summary { border: 1px solid #ffffff20; border-radius: 7px; background: #17212d; padding: 1.15rem; }
  #cart-drawer .summary-title { margin-bottom: 1rem; font-size: .84rem; font-weight: 650; letter-spacing: 0; text-transform: none; color: #ecf2f6; }
  #cart-drawer .checkout-items { display: flex; flex-direction: column; gap: .75rem; margin-bottom: 1.15rem; }
  #cart-drawer .checkout-items .line { display: flex; justify-content: space-between; gap: 1rem; font-size: .83rem; line-height: 1.5; }
  #cart-drawer .checkout-items .line > span:last-child { flex-shrink: 0; font-variant-numeric: tabular-nums; }
  #cart-drawer .checkout-items .qty-note { color: #aebccc; white-space: nowrap; }
  #cart-drawer #checkout-form { display: flex; flex-direction: column; gap: 1.1rem; }
  #cart-drawer .field { display: flex; flex-direction: column; gap: .5rem; min-width: 0; }
  #cart-drawer .field label { font-size: .83rem; font-weight: 550; color: #dbe3eb; }
  #cart-drawer .field input, #cart-drawer .field select { display: block; width: 100%; min-width: 0; min-height: 48px; padding: .8rem .9rem; border: 1px solid #65738699; border-radius: 6px; background: #0a111a; color: #f1f4f7; font: inherit; font-size: 1rem; color-scheme: dark; }
  #cart-drawer .field input::placeholder { color: #8998aa; }
  #cart-drawer .field input:focus, #cart-drawer .field select:focus { border-color: #b7d4e5; box-shadow: 0 0 0 2px #b7d4e51a; }
  #cart-drawer .field input[aria-invalid='true'] { border-color: #e28f98; }
  #cart-drawer .field .error { display: none; color: #f0aab2; font-size: .8rem; line-height: 1.5; }
  #cart-drawer .field input[aria-invalid='true'] ~ .error { display: block; }
  #cart-drawer .field-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: .9rem; }
  #cart-drawer .payment-block { padding-top: 1.35rem; border-top: 1px solid #ffffff20; }
  #cart-drawer .payment-head { display: flex; align-items: center; gap: .6rem; margin-bottom: 1.15rem; color: #b5c8d7; }
  #cart-drawer .payment-head h3 { font-family: var(--font-display); font-size: 1rem; font-weight: 650; color: #f1f4f7; }
  #cart-drawer .payment-note { margin-top: .95rem; font-size: .71rem; line-height: 1.6; text-align: center; color: #9caebe; }
  @media (max-width: 380px) {
    #cart-drawer .drawer-head, #cart-drawer .drawer-body, #cart-drawer .drawer-foot { padding-inline: 1.1rem; }
    #cart-drawer .field-row { grid-template-columns: 1fr; }
    #cart-drawer .cart-item { column-gap: .7rem; grid-template-columns: 72px minmax(0, 1fr) 44px; }
    #cart-drawer .cart-item > img { width: 72px; height: 90px; }
  }
  @media (max-height: 600px) {
    #cart-drawer .drawer-head { padding-block: .8rem; }
    #cart-drawer .drawer-logo { width: 6.5rem; }
    #cart-drawer .drawer-brand { gap: .45rem; }
    #cart-drawer .drawer-head h2 { font-size: 1.2rem; }
    #cart-drawer .drawer-foot { padding-block: .85rem; }
    #cart-drawer .drawer-foot-inner { gap: .75rem; }
    #cart-drawer .totals { gap: .35rem; }
  }
  @media (prefers-reduced-motion: reduce) { #cart-drawer, #cart-backdrop, #cart-drawer button { transition: none; } }
</style>
